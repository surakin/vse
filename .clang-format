# The engine's C++ style (CLAUDE.md, "Code style"). Allman braces, every control-flow body braced, 120 columns, 4 spaces, pointers bind to the type.
# Formatted by scripts/format.sh and by the pre-commit hook (scripts/install-git-hooks.sh); clang-format 18 or newer (BUILD.md).
# Files that must not be touched are in .clang-format-ignore.
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
BreakBeforeBraces: Allman
InsertBraces: true
InsertNewlineAtEOF: true
PointerAlignment: Left
AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true
SpacesBeforeTrailingComments: 2
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All
AllowShortEnumsOnASingleLine: false
# The include order is part of the build: the unity enable/disable pairs and macro-saving headers (CLAUDE.md, "Unity builds") depend on it.
SortIncludes: Never
IncludeBlocks: Preserve
IndentPPDirectives: None
BreakStringLiterals: false
# Never break after `=` to make room for a trailing comment (`kFlag =\n 1,  ///< ...`): the comment wraps under itself instead.
PenaltyBreakAssignment: 1000
# Comments are wrapped at the column limit. Doc-comment labels are list items (`/// - Fails: ...`, docs/DOC-CONVENTIONS.md), which reflow leaves on a line of their own.
ReflowComments: true
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtStartOfBlock: false
