log.console                          auto           default auto         from defaults                           the console log device: auto (colour on a colour terminal), plain, color or off
log.file.keep                        3              default 3            from defaults                           rotated log files kept (name.1 is the newest)
log.file.level                       trace          default trace        from defaults                           the least severe level written to the log file
log.file.max_bytes                   10485760       default 10485760     from defaults                           rotate the log file at this size in bytes (0: never)
log.file.path                        ""             default ""           from defaults                           append the log to this file (empty: no log file); its directory must exist
log.io.enabled                       true           default true         from defaults                           whether the channel logs at all
log.io.verbosity                     warn           default warn         from defaults                           how much the channel logs: error, warn, info, debug or trace
log.logbuild.enabled                 true           default true         from defaults                           whether the channel logs at all
log.logbuild.verbosity               info           default info         from defaults                           how much the channel logs: error, warn, info, debug or trace
log.logcore.enabled                  true           default true         from defaults                           whether the channel logs at all
log.logcore.verbosity                warn           default warn         from defaults                           how much the channel logs: error, warn, info, debug or trace
log.logcrash.enabled                 true           default true         from defaults                           whether the channel logs at all
log.logcrash.verbosity               warn           default warn         from defaults                           how much the channel logs: error, warn, info, debug or trace
log.logjobs.enabled                  true           default true         from defaults                           whether the channel logs at all
log.logjobs.verbosity                warn           default warn         from defaults                           how much the channel logs: error, warn, info, debug or trace
log.logplatform.enabled              true           default true         from defaults                           whether the channel logs at all
log.logplatform.verbosity            warn           default warn         from defaults                           how much the channel logs: error, warn, info, debug or trace
log.logrender.enabled                true           default true         from defaults                           whether the channel logs at all
log.logrender.verbosity              warn           default warn         from defaults                           how much the channel logs: error, warn, info, debug or trace
log.logrhi.enabled                   true           default true         from defaults                           whether the channel logs at all
log.logrhi.verbosity                 info           default info         from defaults                           how much the channel logs: error, warn, info, debug or trace
platform.window_backend              auto           default auto         from defaults                           the display backend: wayland or x11 on Linux, win32 on Windows, cocoa on macOS (auto picks Wayland, then X11, on Linux)
renderer.adapter                     ""             default ""           from defaults                           the GPU: an id from --list-gpus, an index, or part of the name (empty: the best one)
renderer.backend                     auto           default auto         from defaults                           the graphics backend: auto (the preferred one this program has and this machine runs), null (no GPU), vulkan, dx12 or metal
renderer.frames_in_flight            2              default 2            from defaults                           frames the CPU may record ahead of the GPU (1 to 3)
renderer.fullscreen                  false          default false        from defaults                           fullscreen (needs the fullscreen capability)
renderer.gbuffer_debug_layer         none           default none         from defaults                           show a G-buffer layer instead of the lit picture
renderer.hdr                         off            default off          from defaults                           HDR output: off, scrgb or hdr10 (needs the hdr capability)
renderer.height                      0              default 0            from defaults                           the window height in pixels (0: the default size)
renderer.joint_palette_bytes         16777216       default 16777216     from defaults                           the room for skinned meshes' joint matrices per frame in bytes (48 per joint); objects that do not fit are not drawn
renderer.present_mode                fifo           default fifo         from defaults                           how frames reach the display: fifo (vsync), mailbox or immediate
renderer.render_scale                1.0            default 1.0          from defaults                           the internal resolution as a fraction of the window
renderer.shader_quality              high           default high         from defaults                           shader quality: low, medium or high
renderer.swapchain_format            auto           default auto         from defaults                           the swapchain format: auto, srgb8, rgba16f or rgb10a2
renderer.sync_validation             false          default false        from defaults                           also run synchronization validation
renderer.terrain_first_range         128.0          default 128.0        from defaults                           
renderer.terrain_max_distance        0.0            default 0.0          from defaults                           
renderer.terrain_morph_fraction      0.30000001192092896 default 0.30000001192092896 from defaults                           
renderer.validation                  auto           default auto         from defaults                           the validation layer: auto, off or on
renderer.width                       0              default 0            from defaults                           the window width in pixels (0: the default size)
rhi.pipeline_cache                   true           default true         from defaults                           keep the Vulkan pipeline cache on disk
rhi.pipeline_cache_dir               ""             default ""           from defaults                           the directory of the pipeline cache file (empty: the user cache directory)
