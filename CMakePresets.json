{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux",
      "displayName": "Linux (Clang, else the default compiler; build/)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-nojit",
      "displayName": "Linux with LuaJIT's JIT compiled out (build-nojit/; the script_nojit flavor, Phase 27 Day 470)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-nojit",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ENGINE_LUAJIT_JIT": "OFF" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows, MSVC (build-msvc/); finds Visual Studio and the Windows SDK itself",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-msvc",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-msvc.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-clang-cl",
      "displayName": "Windows, clang-cl (build-clang-cl/); finds LLVM, Visual Studio and the Windows SDK itself",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang-cl",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-clang-cl.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos-clang-x86_64",
      "displayName": "macOS, Apple clang from the Command Line Tools (build-macos/); x86-64 (under Rosetta 2 on Apple silicon), deployment target 13.3",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3", "CMAKE_OSX_ARCHITECTURES": "x86_64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-clang-arm64",
      "displayName": "macOS arm64 (build-macos-arm64/): native on Apple silicon; compile-only when configured on an Intel Mac",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos-arm64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3", "CMAKE_OSX_ARCHITECTURES": "arm64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-nojit", "configurePreset": "linux-nojit" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc" },
    { "name": "windows-clang-cl", "configurePreset": "windows-clang-cl" },
    { "name": "macos-clang-x86_64", "configurePreset": "macos-clang-x86_64" },
    { "name": "macos-clang-arm64", "configurePreset": "macos-clang-arm64" }
  ],
  "testPresets": [
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "output": { "outputOnFailure": true } },
    { "name": "windows-clang-cl", "configurePreset": "windows-clang-cl", "output": { "outputOnFailure": true } },
    { "name": "macos-clang-x86_64", "configurePreset": "macos-clang-x86_64", "output": { "outputOnFailure": true } },
    { "name": "macos-clang-arm64", "configurePreset": "macos-clang-arm64", "output": { "outputOnFailure": true } }
  ]
}
