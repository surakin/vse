# Compiles every engine shader (and every permutation key of the permuted ones) to HLSL and Metal Shading Language with slangc,
# the proof that the sources are not Vulkan in disguise (Phases 13 and 26 take the D3D12 and Metal backends from these same sources).
# Run through ctest as `shaders_portability`; arguments: SLANGC, SHADER_DIR, WORK_DIR, SHADERS (a ;-list), DXC (optional),
# DXC_REQUIRED (ON on Windows with the SDK's dxc: a rejected HLSL then fails the test). The HLSL is built with the D3D12 target
# define (shaders/target_common.slang), as the minted DXIL is.
# A shader fails the test if slangc exits non-zero, writes an `error`, or produces an empty file. Warnings are expected and
# listed (Metal renames `main`). `dxc`, if installed, additionally compiles the HLSL to DXIL and reports what it rejects without
# failing (the instance-index semantic is a known Phase 13 gap). The Metal source is built with the Metal target define, and on
# a Mac METAL_MINT (tools/metal_mint, Phase 26 Day 315) compiles every key's Metal source with the driver and loads the result.
# See README.md, "Other targets".
include(${SHADER_DIR}/names.cmake)
# Shaders known not to compile to a target, with the reason; the test fails if one of these starts to compile (remove it from
# the list) or if any other shader does not. Empty since Phase 26 Day 315 (fill.comp and saxpy.comp take their element count as
# a push constant instead of asking the buffer, which Metal Shading Language cannot do).
set(KNOWN_UNAVAILABLE "")
file(MAKE_DIRECTORY ${WORK_DIR})
set(compiled 0)
set(skipped 0)
set(dxc_checked 0)
set(metal_minted 0)
foreach(shader ${SHADERS})
  shader_stage(${shader} stage)
  # The keys to build: a permuted shader's manifest lists them; any other shader has the one empty key.
  set(keys "")
  set(manifest ${SHADER_DIR}/${shader}.perm)
  if(EXISTS ${manifest})
    file(STRINGS ${manifest} lines REGEX "^key ")
    foreach(line ${lines})
      string(REGEX REPLACE "^key +" "" opts "${line}")
      string(STRIP "${opts}" opts)
      if(opts STREQUAL "-")
        set(opts "")
      endif()
      string(REPLACE " " "+" tag "${opts}")
      list(APPEND keys "${tag}|${opts}")
    endforeach()
  else()
    set(keys "|")
  endif()
  foreach(key ${keys})
    string(REPLACE "|" ";" parts "${key}")
    list(GET parts 0 tag)
    list(LENGTH parts parts_len)
    set(defines "")
    if(parts_len GREATER 1)
      list(GET parts 1 opts)
      string(REPLACE " " ";" opt_list "${opts}")
      foreach(opt ${opt_list})
        if(NOT opt STREQUAL "")
          list(APPEND defines -D${opt}=1)
        endif()
      endforeach()
    endif()
    foreach(target hlsl metal)
      set(ext hlsl)
      if(target STREQUAL "metal")
        set(ext metal)
      endif()
      set(out ${WORK_DIR}/${shader}${tag}.${ext})
      file(REMOVE ${out})
      set(target_defines "")
      if(target STREQUAL "hlsl")
        set(target_defines -DENGINE_TARGET_D3D12=1)
      else()
        set(target_defines -DENGINE_TARGET_METAL=1)
      endif()
      execute_process(
        COMMAND ${SLANGC} ${SHADER_DIR}/${shader}.slang -target ${target} -entry main -stage ${stage} -matrix-layout-column-major
                ${defines} ${target_defines} -o ${out}
        RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
      set(text "${stdout}${stderr}")
      set(failed FALSE)
      if(NOT rc EQUAL 0 OR text MATCHES "error\\[E[0-9]+\\]")
        set(failed TRUE)
      endif()
      if("${target}:${shader}" IN_LIST KNOWN_UNAVAILABLE)
        if(NOT failed)
          message(FATAL_ERROR "${shader}.slang now compiles to ${target}: remove it from KNOWN_UNAVAILABLE in portability.cmake")
        endif()
        if(NOT text MATCHES "GetDimensions")
          message(FATAL_ERROR "${shader}.slang fails to compile to ${target} for a reason other than the documented one (GetDimensions):\n${text}")
        endif()
        math(EXPR skipped "${skipped} + 1")
        continue()
      endif()
      if(failed)
        message(FATAL_ERROR "slangc could not compile ${shader}.slang ${tag} to ${target}:\n${text}")
      endif()
      if(NOT EXISTS ${out})
        message(FATAL_ERROR "slangc wrote nothing for ${shader}.slang ${tag} (${target})")
      endif()
      file(SIZE ${out} size)
      if(size EQUAL 0)
        message(FATAL_ERROR "slangc wrote an empty file for ${shader}.slang ${tag} (${target})")
      endif()
      if(text MATCHES "warning")
        string(REGEX MATCHALL "warning [A-Z0-9]+: [^\n]*" warnings "${text}")
        foreach(w ${warnings})
          if(NOT w MATCHES "entry point 'main' has been renamed")
            message("note: ${shader}${tag} (${target}): ${w}")
          endif()
        endforeach()
      endif()
      math(EXPR compiled "${compiled} + 1")
      if(target STREQUAL "metal" AND METAL_MINT)
        execute_process(COMMAND ${METAL_MINT} --source ${out} --stage ${stage} --out ${WORK_DIR}/${shader}${tag}.metallib
                                --info ${WORK_DIR}/${shader}${tag}.metallib.info
                        RESULT_VARIABLE mint_rc ERROR_VARIABLE mint_err)
        if(NOT mint_rc EQUAL 0)
          message(FATAL_ERROR "the Metal compiler rejected ${shader}${tag}: ${mint_err}")
        endif()
        math(EXPR metal_minted "${metal_minted} + 1")
      endif()
      if(target STREQUAL "hlsl" AND DXC)
        set(profile vs_6_0)
        if(stage STREQUAL "fragment")
          set(profile ps_6_0)
        elseif(stage STREQUAL "compute")
          set(profile cs_6_0)
        endif()
        execute_process(COMMAND ${DXC} -T ${profile} -E main ${out} -Fo ${WORK_DIR}/${shader}${tag}.dxil
                        RESULT_VARIABLE dxc_rc ERROR_VARIABLE dxc_err OUTPUT_QUIET)
        if(dxc_rc EQUAL 0)
          math(EXPR dxc_checked "${dxc_checked} + 1")
        elseif(DXC_REQUIRED)
          message(FATAL_ERROR "dxc rejected the HLSL of ${shader}${tag}: ${dxc_err}")
        else()
          # Off Windows dxc is optional and the Linux package aborts (KNOWN-ISSUES.md): reported, not fatal.
          message("note: dxc rejected the HLSL of ${shader}${tag}: ${dxc_err}")
        endif()
      endif()
    endforeach()
  endforeach()
endforeach()
message("compiled ${compiled} outputs (HLSL and Metal) for the engine shaders; ${skipped} known unavailable; dxc checked ${dxc_checked}; "
        "Metal minted ${metal_minted}")
