# Recompiles every shader and compares the result with the committed .spv.inc file. Run through ctest as
# `shaders_check`; arguments: GLSLC, SPIRV_VAL (optional), SPV_EMBED, SHADER_DIR, WORK_DIR, SHADERS (a ;-list).
# Prints "SKIP:" (the test's SKIP_REGULAR_EXPRESSION) when the installed glslc is not the version that generated the committed files.
include(${SHADER_DIR}/names.cmake)
execute_process(COMMAND ${GLSLC} --version OUTPUT_VARIABLE version_text OUTPUT_STRIP_TRAILING_WHITESPACE)
string(REGEX REPLACE "\n.*" "" glslc_version "${version_text}")
file(MAKE_DIRECTORY ${WORK_DIR})
foreach(shader ${SHADERS})
  set(committed ${SHADER_DIR}/${shader}.spv.inc)
  file(STRINGS ${committed} recorded REGEX "^// glslc: ")
  if(NOT recorded)
    message(FATAL_ERROR "${shader}.spv.inc has no '// glslc: <version>' line: regenerate it with the `shaders` target")
  endif()
  if(NOT recorded STREQUAL "// glslc: ${glslc_version}")
    message("SKIP: ${shader}: committed with '${recorded}', installed is '${glslc_version}'")
    set(skipped TRUE)
    continue()
  endif()
  execute_process(COMMAND ${GLSLC} --target-env=vulkan1.3 -O ${SHADER_DIR}/${shader} -o ${WORK_DIR}/${shader}.spv
                  RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "glslc failed on ${shader}: ${err}")
  endif()
  if(SPIRV_VAL)
    execute_process(COMMAND ${SPIRV_VAL} --target-env vulkan1.3 ${WORK_DIR}/${shader}.spv RESULT_VARIABLE rc ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "spirv-val rejected ${shader}: ${err}")
    endif()
  endif()
  shader_symbol(${shader} symbol)
  execute_process(COMMAND ${SPV_EMBED} --name ${symbol} --source ${shader} --compiler ${glslc_version}
                          --out ${WORK_DIR}/${shader}.spv.inc ${WORK_DIR}/${shader}.spv RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "spv_embed failed on ${shader}")
  endif()
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${committed} ${WORK_DIR}/${shader}.spv.inc RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "${shader}.spv.inc is out of date: run `cmake --build build --target shaders`")
  endif()
endforeach()
