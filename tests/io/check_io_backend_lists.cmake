# Backend list gate for the file layer (Phase 9 Day 124). Run as: cmake -DROOT=<tree> [-DBACKEND_FILE=<file>] -P check_io_backend_lists.cmake
# Every function in engine/foundation/io/*.h whose doc comment carries a `Backend:` label must have a `### ` section (its name in backticks on the
# heading) in engine/foundation/io/BACKEND.md, so the checklist for the Windows, macOS, mobile and console backends cannot fall behind the
# headers. The reverse also holds: a `### ` heading that names a function must name one that carries the label.
cmake_minimum_required(VERSION 3.20)
if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree>")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT BACKEND_FILE)
  set(BACKEND_FILE "${ROOT}/engine/foundation/io/BACKEND.md")
endif()

file(GLOB headers "${ROOT}/engine/foundation/io/*.h")
set(labeled "")
foreach(h IN LISTS headers)
  file(READ "${h}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" content "${content}")
  set(waiting FALSE)
  foreach(line IN LISTS content)
    if(line MATCHES "^[ \t]*/// - Backend:")
      set(waiting TRUE)
      continue()
    endif()
    if(waiting)
      if(line MATCHES "^[ \t]*///")
        continue()
      endif()
      # The declaration: the identifier just before the first '('.
      if(line MATCHES "([A-Za-z_][A-Za-z0-9_]*)[ \t]*\\(")
        list(APPEND labeled "${CMAKE_MATCH_1}")
      else()
        message(SEND_ERROR "${h}: a Backend: label is not followed by a function declaration: ${line}")
      endif()
      set(waiting FALSE)
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES labeled)
list(LENGTH labeled count)
if(count EQUAL 0)
  message(SEND_ERROR "no Backend: labels found under ${ROOT}/engine/foundation/io; the labels have been lost")
endif()

if(NOT EXISTS "${BACKEND_FILE}")
  message(FATAL_ERROR "missing ${BACKEND_FILE}")
endif()
file(READ "${BACKEND_FILE}" text)
string(REPLACE "\n" ";" lines "${text}")
set(listed "")
set(errors 0)
foreach(line IN LISTS lines)
  if(line MATCHES "^### ")
    string(REGEX MATCHALL "`[A-Za-z_][A-Za-z0-9_]*`" names "${line}")
    foreach(quoted IN LISTS names)
      string(REPLACE "`" "" bare "${quoted}")
      list(APPEND listed "${bare}")
      list(FIND labeled "${bare}" at)
      if(at LESS 0)
        message(SEND_ERROR "BACKEND.md lists `${bare}`, which has no Backend: label in any io header")
        math(EXPR errors "${errors}+1")
      endif()
    endforeach()
  endif()
endforeach()
foreach(name IN LISTS labeled)
  list(FIND listed "${name}" at)
  if(at LESS 0)
    message(SEND_ERROR "${name} carries a Backend: label but BACKEND.md has no ### section for it")
    math(EXPR errors "${errors}+1")
  endif()
endforeach()
if(errors GREATER 0)
  message(FATAL_ERROR "io_backend_lists: ${errors} problem(s)")
endif()
message(STATUS "io_backend_lists: ${count} functions listed")
