# Backend lifecycle list gate (Phase 7 Day 114). Run as: cmake -DROOT=<tree> -P check_lifecycle_list.cmake
# Every pure virtual function of rhi::Device and rhi::Swapchain that belongs to the device lifecycle (listed below, in step with the
# interface) must appear in engine/rhi/BACKEND-LIFECYCLE.md as a `### ` section naming it in backticks, and every section must name
# a function the interfaces still declare, so the checklist for the DX12 and Metal backends cannot fall behind the headers.
cmake_minimum_required(VERSION 3.20)
if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree>")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
set(required Quiesce Resources InFrame Epoch Adapter RecreateSurface InjectDeviceLoss WaitIdle DeviceLost Reconfigure ActualPresentMode
    GetColorSpace Capabilities EnumerateAdapters CreateDevice)
file(READ "${ROOT}/engine/rhi/device.h" device_h)
file(READ "${ROOT}/engine/rhi/swapchain.h" swapchain_h)
file(READ "${ROOT}/engine/rhi/adapter.h" adapter_h)
file(READ "${ROOT}/engine/rhi/rhi.h" rhi_h)
set(all "${device_h}\n${swapchain_h}\n${adapter_h}\n${rhi_h}")
file(READ "${ROOT}/engine/rhi/BACKEND-LIFECYCLE.md" list_text)
string(REPLACE "\n" ";" lines "${list_text}")
set(listed "")
foreach(line IN LISTS lines)
  if(line MATCHES "^### ")
    string(REGEX MATCHALL "`[A-Za-z_]+`" names "${line}")
    foreach(n IN LISTS names)
      string(REPLACE "`" "" n "${n}")
      list(APPEND listed "${n}")
    endforeach()
  endif()
endforeach()
set(errors 0)
foreach(fn IN LISTS required)
  if(NOT all MATCHES "[ \t:]${fn}\\(")
    message(SEND_ERROR "the interface headers no longer declare ${fn}: update the gate's list")
    math(EXPR errors "${errors}+1")
  endif()
  list(FIND listed "${fn}" at)
  if(at LESS 0)
    message(SEND_ERROR "engine/rhi/BACKEND-LIFECYCLE.md has no ### section for `${fn}`")
    math(EXPR errors "${errors}+1")
  endif()
endforeach()
foreach(n IN LISTS listed)
  list(FIND required "${n}" at)
  if(at LESS 0)
    message(SEND_ERROR "engine/rhi/BACKEND-LIFECYCLE.md has a section for `${n}`, which the gate does not require (add it to the list or remove the section)")
    math(EXPR errors "${errors}+1")
  endif()
endforeach()
if(errors GREATER 0)
  message(FATAL_ERROR "${errors} problem(s) with the lifecycle checklist")
endif()
list(LENGTH required count)
message(STATUS "all ${count} lifecycle functions are listed")
