# Backend list gate (Phase 7 Day 101). Run as:
#   cmake -DROOT=<tree> -P check_backend_lists.cmake
# Every neutral function whose doc comment carries a `Backend:` label must have a `### ` section (its name in backticks on the heading) in both
# engine/foundation/os/windows/debug/BACKEND.md and engine/foundation/os/macos/debug/BACKEND.md, so the checklists for Phases 13 and 23
# cannot fall behind the headers. The reverse also holds: a `### ` heading that names a function must name only functions that
# carry the label.
cmake_minimum_required(VERSION 3.20)
if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree>")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)

file(GLOB_RECURSE headers "${ROOT}/engine/foundation/*.h")
set(labeled "")
foreach(h IN LISTS headers)
  if(h MATCHES "/engine/foundation/io/")
    continue() # the file layer has its own list: engine/foundation/io/BACKEND.md, checked by io_backend_lists
  endif()
  if(h MATCHES "/engine/foundation/settings/")
    continue() # the settings system has its own list: engine/foundation/settings/BACKEND.md, checked by settings_backend_lists
  endif()
  file(READ "${h}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" content "${content}")
  set(waiting FALSE)
  foreach(line IN LISTS content)
    if(line MATCHES "^[ \t]*/// Backend:")
      set(waiting TRUE)
      continue()
    endif()
    if(waiting)
      if(line MATCHES "^[ \t]*///")
        continue()
      endif()
      # The declaration: the identifier just before the first '('.
      if(line MATCHES "([A-Za-z_][A-Za-z0-9_]*)[ \t]*\\(")
        list(APPEND labeled "${CMAKE_MATCH_1}")
      else()
        message(SEND_ERROR "${h}: a Backend: label is not followed by a function declaration: ${line}")
      endif()
      set(waiting FALSE)
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES labeled)
list(LENGTH labeled count)
if(count EQUAL 0)
  message(SEND_ERROR "no Backend: labels found under ${ROOT}; the labels have been lost")
endif()

set(errors 0)
foreach(platform windows macos)
  set(list_file "${ROOT}/engine/foundation/os/${platform}/debug/BACKEND.md")
  if(NOT EXISTS "${list_file}")
    message(SEND_ERROR "missing ${list_file}")
    math(EXPR errors "${errors}+1")
    continue()
  endif()
  file(READ "${list_file}" text)
  string(REPLACE "\n" ";" lines "${text}")
  # The names of the functions that have a section: the backticked names on `### ` heading lines.
  set(listed "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^### ")
      string(REGEX MATCHALL "`[A-Za-z_][A-Za-z0-9_]*`" names "${line}")
      foreach(quoted IN LISTS names)
        string(REPLACE "`" "" bare "${quoted}")
        list(APPEND listed "${bare}")
        list(FIND labeled "${bare}" at)
        if(at LESS 0)
          message(SEND_ERROR "${platform}: BACKEND.md lists `${bare}`, which has no Backend: label in any header")
          math(EXPR errors "${errors}+1")
        endif()
      endforeach()
    endif()
  endforeach()
  foreach(name IN LISTS labeled)
    list(FIND listed "${name}" at)
    if(at LESS 0)
      message(SEND_ERROR "${platform}: BACKEND.md has no section heading for `${name}`, which carries a Backend: label")
      math(EXPR errors "${errors}+1")
    endif()
  endforeach()
endforeach()
if(errors GREATER 0)
  message(FATAL_ERROR "debug_backend_lists: ${errors} problem(s)")
endif()
message(STATUS "debug_backend_lists: ${count} labeled function(s) listed for Windows and macOS")
