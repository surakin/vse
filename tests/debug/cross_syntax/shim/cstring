// Stand-in for the standard header (see cstddef): declarations of the C string functions the engine headers use.
// Like the real header in C++, the searching functions have a const and a non-const overload.
#pragma once
#include <stddef.h>
extern "C" {
void* memcpy(void*, const void*, size_t);
void* memmove(void*, const void*, size_t);
void* memset(void*, int, size_t);
int memcmp(const void*, const void*, size_t);
size_t strlen(const char*);
int strcmp(const char*, const char*);
int strncmp(const char*, const char*, size_t);
char* strncpy(char*, const char*, size_t);
char* strcpy(char*, const char*);
char* strcat(char*, const char*);
}
const void* memchr(const void*, int, size_t);
void* memchr(void*, int, size_t);
const char* strchr(const char*, int);
char* strchr(char*, int);
const char* strrchr(const char*, int);
char* strrchr(char*, int);
const char* strstr(const char*, const char*);
char* strstr(char*, const char*);
const char* strpbrk(const char*, const char*);
char* strpbrk(char*, const char*);
namespace std {
using ::memchr;
using ::memcmp;
using ::memcpy;
using ::memmove;
using ::memset;
using ::strcat;
using ::strchr;
using ::strcmp;
using ::strcpy;
using ::strlen;
using ::strncmp;
using ::strncpy;
using ::strpbrk;
using ::strrchr;
using ::strstr;
} // namespace std
