// Stand-in for the standard header (see cstddef): the ratios chrono names.
#pragma once
namespace std {
template <long long N, long long D = 1> struct ratio { static constexpr long long num = N; static constexpr long long den = D; };
using nano = ratio<1, 1000000000>;
using micro = ratio<1, 1000000>;
using milli = ratio<1, 1000>;
} // namespace std
