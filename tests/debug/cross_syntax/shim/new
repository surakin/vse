// Stand-in for the standard header (see cstddef): placement new, the aligned and nothrow forms.
#pragma once
#include <stddef.h>
namespace std {
struct nothrow_t {};
inline constexpr nothrow_t nothrow{};
enum class align_val_t : size_t {};
} // namespace std
inline void* operator new(size_t, void* where) noexcept { return where; }
inline void operator delete(void*, void*) noexcept {}
void* operator new(size_t, std::align_val_t, const std::nothrow_t&) noexcept;
void operator delete(void*, std::align_val_t) noexcept;
void operator delete(void*) noexcept;
