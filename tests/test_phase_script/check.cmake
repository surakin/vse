# One case of scripts/test-phase.sh --dry-run: runs it, checks the phases it reports, and checks that its "X of Y"
# equals what `ctest -N` selects with the given arguments (Phase 5).
#   cmake -DSCRIPT=<test-phase.sh> -DBUILD=<dir> -DARGS="--affected;..." -DEXPECT_PHASES="3 4" -DCTEST_ARGS="-L;^phase3$"
#         [-DEXPECT_FAIL_TEXT=<text>] -P check.cmake   (EXPECT_PHASES=ANY: only check that the run worked)
# ARGS and CTEST_ARGS are ';'-lists. Without CTEST_ARGS the case selects every test.
find_program(BASH bash REQUIRED)
execute_process(COMMAND ${BASH} ${SCRIPT} --dry-run --build-dir ${BUILD} ${ARGS}
  OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(EXPECT_FAIL_TEXT)
  if(rc EQUAL 0)
    message(FATAL_ERROR "expected the script to refuse, but it ran:\n${out}")
  endif()
  if(NOT err MATCHES "${EXPECT_FAIL_TEXT}")
    message(FATAL_ERROR "expected the message '${EXPECT_FAIL_TEXT}', got:\n${err}")
  endif()
  return()
endif()
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "test-phase.sh ${ARGS} failed (${rc}):\n${out}${err}")
endif()
if(NOT out MATCHES "would run ([0-9]+) of ([0-9]+) tests \\(phases: ([^;]*); flavors: ([a-z]+); display: ([a-z]+)\\)")
  message(FATAL_ERROR "no 'would run X of Y' line in:\n${out}")
endif()
set(picked ${CMAKE_MATCH_1})
set(total ${CMAKE_MATCH_2})
set(phases "${CMAKE_MATCH_3}")
if(EXPECT_PHASES STREQUAL "ANY")
  # Only that it worked (the changed paths came from git, so they depend on the checkout).
  if(picked GREATER total OR picked EQUAL 0)
    message(FATAL_ERROR "implausible count:\n${out}")
  endif()
  return()
endif()
if(NOT phases STREQUAL "${EXPECT_PHASES}")
  message(FATAL_ERROR "phases '${phases}', expected '${EXPECT_PHASES}'\n${out}")
endif()
if(DEFINED EXPECT_DISPLAY AND NOT CMAKE_MATCH_5 STREQUAL "${EXPECT_DISPLAY}")
  message(FATAL_ERROR "display '${CMAKE_MATCH_5}', expected '${EXPECT_DISPLAY}'\n${out}")
endif()
function(ctest_count out)
  execute_process(COMMAND ${CMAKE_CTEST_COMMAND} --test-dir ${BUILD} -N ${ARGN} OUTPUT_VARIABLE o)
  string(REGEX MATCH "Total Tests: ([0-9]+)" m "${o}")
  set(${out} ${CMAKE_MATCH_1} PARENT_SCOPE)
endfunction()
ctest_count(want_total)
ctest_count(want_picked ${CTEST_ARGS})
if(NOT total EQUAL want_total OR NOT picked EQUAL want_picked)
  message(FATAL_ERROR "the script says ${picked} of ${total}; ctest says ${want_picked} of ${want_total}")
endif()
if(picked EQUAL 0)
  message(FATAL_ERROR "a case that selects no tests proves nothing:\n${out}")
endif()
