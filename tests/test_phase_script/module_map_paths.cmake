# Fails if a line of tests/module_map.txt names a path that does not exist (a renamed directory).
file(STRINGS "${MAP}" lines)
foreach(line IN LISTS lines)
  string(REGEX REPLACE "#.*$" "" line "${line}")
  string(STRIP "${line}" line)
  if(line STREQUAL "")
    continue()
  endif()
  string(REGEX MATCH "^[^ \t]+" path "${line}")
  if(NOT EXISTS "${ROOT}/${path}")
    string(APPEND missing "  ${path}\n")
  endif()
endforeach()
if(missing)
  message(FATAL_ERROR "tests/module_map.txt names paths that do not exist:\n${missing}")
endif()

# The other direction (added 2026-11-13, after Phase 22 Day 313 created engine/asset without a line and a later `--affected` run could
# not tell which phases it touched): every tracked file (a .gitkeep placeholder aside) must be covered by a line of the map, the file
# itself or a directory above it, which is the script's own rule for a changed path. Checked per directory, with git's file list.
set(map_paths "")
foreach(line IN LISTS lines)
  string(REGEX REPLACE "#.*$" "" line "${line}")
  string(STRIP "${line}" line)
  if(NOT line STREQUAL "")
    string(REGEX MATCH "^[^ \t]+" path "${line}")
    list(APPEND map_paths "${path}")
  endif()
endforeach()
find_program(GIT_PROGRAM git)
if(GIT_PROGRAM AND EXISTS "${ROOT}/.git")
  execute_process(COMMAND ${GIT_PROGRAM} -C "${ROOT}" ls-files RESULT_VARIABLE git_rc OUTPUT_VARIABLE tracked)
  if(git_rc EQUAL 0)
    string(REPLACE "\n" ";" tracked "${tracked}")
    set(checked_dirs "")
    set(unmapped "")
    foreach(file IN LISTS tracked)
      # The script decides these before it asks the map: the build system and the vendored code run everything (or, for a
      # CMakeLists.txt, by its own rules).
      if(file STREQUAL "" OR file MATCHES "(^|/)\\.gitkeep$" OR file MATCHES "(^|/)CMakeLists\\.txt$"
         OR file MATCHES "^(cmake|third_party)/" OR file STREQUAL "CMakePresets.json")
        continue()
      endif()
      get_filename_component(dir "${file}" DIRECTORY)
      set(key "${dir}")
      if(key STREQUAL "")
        set(key "${file}")  # a file at the top level is checked on its own
      endif()
      list(FIND checked_dirs "${key}" seen)
      if(NOT seen EQUAL -1)
        continue()
      endif()
      list(APPEND checked_dirs "${key}")
      set(covered FALSE)
      foreach(path IN LISTS map_paths)
        if(file STREQUAL path OR file MATCHES "^${path}/")
          set(covered TRUE)
          break()
        endif()
      endforeach()
      if(NOT covered)
        string(APPEND unmapped "  ${key}\n")
      endif()
    endforeach()
    if(unmapped)
      message(FATAL_ERROR "these tracked paths have no line in tests/module_map.txt, so `test-phase.sh --affected` could not tell which phases a change in them touches (add a line: the path, then the phases whose tests exercise it, or - for none):\n${unmapped}")
    endif()
  endif()
endif()
