# plain + ASan + TSan selections of one phase add up to the selection of all three flavors (scripts/test-phase.sh).
find_program(BASH bash REQUIRED)
function(selected out)
  execute_process(COMMAND ${BASH} ${SCRIPT} --dry-run --build-dir ${BUILD} ${PHASE} ${ARGN}
    OUTPUT_VARIABLE o RESULT_VARIABLE rc ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${ARGN}: ${o}${e}")
  endif()
  string(REGEX MATCH "would run ([0-9]+) of" m "${o}")
  set(${out} ${CMAKE_MATCH_1} PARENT_SCOPE)
endfunction()
selected(plain --flavor plain)
selected(asan --flavor asan)
selected(tsan --flavor tsan)
selected(all --flavor all)
math(EXPR sum "${plain} + ${asan} + ${tsan}")
if(NOT sum EQUAL all)
  message(FATAL_ERROR "phase ${PHASE}: plain ${plain} + asan ${asan} + tsan ${tsan} = ${sum}, all flavors ${all}")
endif()
message(STATUS "phase ${PHASE}: ${plain} + ${asan} + ${tsan} = ${all}")
