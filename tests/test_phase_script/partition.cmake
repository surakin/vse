# The plain, ASan and TSan selections of one phase add up to the selection of all flavors (scripts/test-phase.sh). FLAVORS names the
# platform's flavors (Windows: plain,asan); a flavor with no tests of the phase counts 0 (the script refuses an empty selection).
if(NOT BASH)
  find_program(BASH bash REQUIRED)  # Windows passes Git's bash.exe as -DBASH
endif()
if(NOT FLAVORS)
  set(FLAVORS plain,asan,tsan)
endif()
string(REPLACE "," ";" FLAVORS "${FLAVORS}")
function(selected out)
  execute_process(COMMAND ${BASH} ${SCRIPT} --dry-run --build-dir ${BUILD} ${PHASE} ${ARGN}
    OUTPUT_VARIABLE o RESULT_VARIABLE rc ERROR_VARIABLE e)
  if(NOT rc EQUAL 0 AND e MATCHES "contains no tests")
    set(${out} 0 PARENT_SCOPE)
    return()
  endif()
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${ARGN}: ${o}${e}")
  endif()
  string(REGEX MATCH "would run ([0-9]+) of" m "${o}")
  set(${out} ${CMAKE_MATCH_1} PARENT_SCOPE)
endfunction()
set(sum 0)
set(parts "")
foreach(flavor IN LISTS FLAVORS)
  selected(n --flavor ${flavor})
  math(EXPR sum "${sum} + ${n}")
  string(APPEND parts " ${flavor} ${n}")
endforeach()
selected(all --flavor all)
if(all EQUAL 0)
  message(FATAL_ERROR "phase ${PHASE} has no tests here; a partition of nothing proves nothing")
endif()
if(NOT sum EQUAL all)
  message(FATAL_ERROR "phase ${PHASE}:${parts} = ${sum}, all flavors ${all}")
endif()
message(STATUS "phase ${PHASE}:${parts} = ${all}")
