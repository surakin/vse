# Every member of the function table in include/engine/engine_c.h is called by include/engine/engine.h (the C++ layer),
# (a call through the pointer, or the destroy member a handle owner holds), so a function added to the table without a wrapper fails here. Run as: cmake -DC_HEADER=<engine_c.h> -DCXX_HEADER=<engine.h> -P
file(READ "${C_HEADER}" c_text)
file(READ "${CXX_HEADER}" cxx_text)
string(FIND "${c_text}" "typedef struct engine_api" begin)
string(FIND "${c_text}" "} engine_api;" end)
if(begin LESS 0 OR end LESS begin)
  message(FATAL_ERROR "engine_h_coverage: the table is not in ${C_HEADER}")
endif()
math(EXPR length "${end} - ${begin}")
string(SUBSTRING "${c_text}" ${begin} ${length} table)
string(REGEX MATCHALL "\\(\\*[ \t]*[a-z_0-9]+\\)" members "${table}")
set(missing "")
set(count 0)
foreach(member IN LISTS members)
  string(REGEX REPLACE "\\(\\*[ \t]*([a-z_0-9]+)\\)" "\\1" name "${member}")
  math(EXPR count "${count} + 1")
  if(NOT cxx_text MATCHES "(->|engine_api::)[ \t\n]*${name}[^a-z_0-9]")
    string(APPEND missing " ${name}")
  endif()
endforeach()
if(count LESS 90)
  message(FATAL_ERROR "engine_h_coverage: only ${count} table members found (the parser is out of step with the header)")
endif()
if(NOT "${missing}" STREQUAL "")
  message(FATAL_ERROR "engine_h_coverage: engine.h does not call these functions of the table:${missing}")
endif()
message(STATUS "engine_h_coverage: ${count} table members, all used by engine.h")
