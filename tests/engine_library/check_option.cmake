# The option ENGINE_BUILD_SHARED exists in the cache, is a boolean, and and is declared OFF (a changed default fails here).
file(STRINGS "${CACHE}" lines REGEX "^ENGINE_BUILD_SHARED:BOOL=")
list(LENGTH lines count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "ENGINE_BUILD_SHARED is not in ${CACHE}")
endif()
if(NOT lines MATCHES "=(ON|OFF)$")
  message(FATAL_ERROR "ENGINE_BUILD_SHARED is not a boolean: ${lines}")
endif()
# The declared default, in every platform branch of the root CMakeLists.txt, is OFF.
file(STRINGS "${ROOT}/CMakeLists.txt" declared REGEX "^[ \t]*option\\(ENGINE_BUILD_SHARED ")
list(LENGTH declared declared_count)
if(declared_count LESS 1)
  message(FATAL_ERROR "no option(ENGINE_BUILD_SHARED ...) in ${ROOT}/CMakeLists.txt")
endif()
foreach(line IN LISTS declared)
  if(NOT line MATCHES "OFF\\)[ \t]*$")
    message(FATAL_ERROR "ENGINE_BUILD_SHARED must default to OFF: ${line}")
  endif()
endforeach()
message(STATUS "engine_shared_option: declared OFF ${declared_count} time(s); this configuration: ${lines}")
