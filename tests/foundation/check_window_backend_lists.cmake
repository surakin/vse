# Backend list gate for the window layer (Phase 15 Day 185). Run as: cmake -DROOT=<tree> [-DBACKEND_FILE=<file>] -P check_window_backend_lists.cmake
# Every directory under engine/platform/ (linux, windows, macos, android, ios, ...) must have a `### ` section in engine/platform/BACKEND.md whose heading names
# it in backticks, and the reverse: a section must name an existing directory, so the checklist cannot fall behind the source tree.
cmake_minimum_required(VERSION 3.20)
if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree>")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT BACKEND_FILE)
  set(BACKEND_FILE "${ROOT}/engine/platform/BACKEND.md")
endif()

file(GLOB children RELATIVE "${ROOT}/engine/platform" "${ROOT}/engine/platform/*")
set(dirs "")
foreach(child IN LISTS children)
  if(IS_DIRECTORY "${ROOT}/engine/platform/${child}")
    list(APPEND dirs "${child}")
  endif()
endforeach()
list(LENGTH dirs count)
if(count EQUAL 0)
  message(SEND_ERROR "no platform directories found under ${ROOT}/engine/platform")
endif()

if(NOT EXISTS "${BACKEND_FILE}")
  message(FATAL_ERROR "missing ${BACKEND_FILE}")
endif()
file(READ "${BACKEND_FILE}" text)
string(REPLACE "\n" ";" lines "${text}")
set(listed "")
set(errors 0)
foreach(line IN LISTS lines)
  if(line MATCHES "^### ")
    string(REGEX MATCHALL "`[A-Za-z_][A-Za-z0-9_]*`" names "${line}")
    foreach(quoted IN LISTS names)
      string(REPLACE "`" "" bare "${quoted}")
      list(APPEND listed "${bare}")
      list(FIND dirs "${bare}" at)
      if(at LESS 0)
        message(SEND_ERROR "BACKEND.md has a section for `${bare}`, which is not a directory under engine/platform")
        math(EXPR errors "${errors}+1")
      endif()
    endforeach()
  endif()
endforeach()
foreach(name IN LISTS dirs)
  list(FIND listed "${name}" at)
  if(at LESS 0)
    message(SEND_ERROR "engine/platform/${name} has no ### section in BACKEND.md")
    math(EXPR errors "${errors}+1")
  endif()
endforeach()
if(errors GREATER 0)
  message(FATAL_ERROR "window_backend_lists: ${errors} problem(s)")
endif()
message(STATUS "window_backend_lists: ${count} platform directories listed")
