# Fails, naming the tests, if any test in a build directory lacks a `phaseN` label or has more than one
# (Phase 6; tests/phases.txt). Run by ctest as test_phase_labels.
#   cmake -DCTEST=<ctest> -DBUILD_DIR=<dir> -DMAP=<tests/phases.txt> [-DCHECK_FLAVORS=1 -DPLATFORM=linux|windows|macos [-DBUILT_FLAVORS=plain,asan,...]] [-DCHECK_UNUSED=1]
#         [-DCURRENT_PHASE_FILE=<CURRENT_PHASE> [-DSIDE_PHASES_FILE=<SIDE_PHASES>]] -P check.cmake
# CHECK_FLAVORS also checks that each phase has tests in exactly the sanitizer flavors its `flavors` line lists for PLATFORM: a
# `flavors <phase> <platform>: <list>` line applies on that platform only, an unqualified line everywhere else, and a phase whose lines
# all name other platforms must have no tests on this one (Phase 13 Day 148: phase 13's tests exist only on Windows);
# BUILT_FLAVORS names the flavors this configuration builds (default all three): a flavor the map lists but the configuration cannot build
# (clang-cl has no ASan flavor yet, Phase 13 Day 150) is not demanded.
# CHECK_UNUSED also fails on a map line that matches no test or file. Both are for the real build, not the fixtures.
# CURRENT_PHASE_FILE (with SIDE_PHASES_FILE) fails on a map phase above the current phase that is not a side phase (Phase 26 Day 302).
include(${CMAKE_CURRENT_LIST_DIR}/../../cmake/EnginePhaseMap.cmake)

# What ctest selects with the given extra arguments, as "<number>: <name>" entries. The number is the test's index in the
# whole build, the same in every selection, so it tells apart tests whose names are equal in their first line (names can
# span lines; only the first line is shown).
function(selected_tests out)
  execute_process(COMMAND ${CTEST} --test-dir ${BUILD_DIR} -N ${ARGN}
    OUTPUT_VARIABLE listing RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "ctest -N ${ARGN} failed (${rc}): ${listing}")
  endif()
  string(REPLACE ";" "," listing "${listing}")  # a name with ';' would split into several list elements
  string(REGEX MATCHALL "\n *Test +#[0-9]+: [^\n]*" lines "${listing}")
  set(names "")
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "^\n *Test +#([0-9]+): " "\\1: " name "${line}")
    list(APPEND names "${name}")
  endforeach()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

engine_phase_map_load("${MAP}")
set(phases "")
foreach(phase IN LISTS _EPM_PHASES)
  engine_phase_label("${phase}" label)
  list(APPEND phases ${label})
endforeach()
list(REMOVE_DUPLICATES phases)

selected_tests(all_tests)
list(LENGTH all_tests total)
if(total EQUAL 0)
  message(FATAL_ERROR "no tests found in ${BUILD_DIR}")
endif()

set(problems "")
selected_tests(unlabeled -LE "^phase")
foreach(name IN LISTS unlabeled)
  string(APPEND problems "  no phase label: ${name}\n")
endforeach()

# A test selected by two different phases carries two labels.
set(seen "")
foreach(label IN LISTS phases)
  selected_tests(in_phase -L "^${label}$")
  foreach(name IN LISTS in_phase)
    list(FIND seen "${name}" at)
    if(at EQUAL -1)
      list(APPEND seen "${name}")
    else()
      string(APPEND problems "  more than one phase label: ${name} (also ${label})\n")
    endif()
  endforeach()
endforeach()

# A phase label that is not in the map (a typo, or a label set by hand).
selected_tests(any_phase -L "^phase")
list(LENGTH any_phase labeled)
list(LENGTH seen known)
if(NOT labeled EQUAL known)
  string(APPEND problems "  ${labeled} tests carry a phase label but only ${known} carry one the map defines\n")
endif()

# Each phase has tests in exactly the flavors the map lists for it on PLATFORM.
if(CHECK_FLAVORS)
  if(NOT PLATFORM MATCHES "^(linux|windows|macos)$")
    message(FATAL_ERROR "check.cmake: CHECK_FLAVORS needs -DPLATFORM=linux, windows or macos (got '${PLATFORM}')")
  endif()
  if(DEFINED BUILT_FLAVORS)
    string(REPLACE "," ";" built "${BUILT_FLAVORS}")
  else()
    set(built plain asan tsan)
  endif()
  file(STRINGS "${MAP}" flavor_lines REGEX "^flavors[ \t]")
  set(keys "")
  foreach(line IN LISTS flavor_lines)
    string(REGEX REPLACE "#.*$" "" line "${line}")
    if(NOT line MATCHES "^flavors[ \t]+([0-9]+)[ \t]+(([a-z]+):[ \t]*)?((plain|asan|tsan)(,(plain|asan|tsan))*|none)[ \t]*$")
      string(APPEND problems "  cannot read the map line '${line}' (want 'flavors <phase> [<platform>:] plain,asan,tsan' or '... none')\n")
      continue()
    endif()
    set(platform "${CMAKE_MATCH_3}")
    set(listed "${CMAKE_MATCH_4}")
    if(listed STREQUAL "none")
      set(listed "-")  # no flavor: the phase has no tests on that platform (yet); a placeholder that is no flavor name
    endif()
    engine_phase_label("${CMAKE_MATCH_1}" label)
    if(NOT platform STREQUAL "" AND NOT platform MATCHES "^(linux|windows|macos)$")
      string(APPEND problems "  the map line '${line}' names the platform '${platform}' (want linux, windows or macos)\n")
      continue()
    endif()
    if("${label}:${platform}" IN_LIST keys)
      if(platform STREQUAL "")
        string(APPEND problems "  two 'flavors' lines for ${label}\n")
      else()
        string(APPEND problems "  two 'flavors' lines for ${label} on ${platform}\n")
      endif()
    endif()
    list(APPEND keys "${label}:${platform}")
    if(NOT label IN_LIST phases)
      string(APPEND problems "  'flavors' line for ${label}, which has no lines in the map\n")
    endif()
    if(platform STREQUAL "")
      set(flavors_any_${label} "${listed}")
    elseif(platform STREQUAL PLATFORM)
      set(flavors_here_${label} "${listed}")
    else()
      set(flavors_elsewhere_${label} TRUE)
    endif()
  endforeach()
  foreach(label IN LISTS phases)
    if(DEFINED flavors_here_${label})
      string(REPLACE "," ";" want "${flavors_here_${label}}")
    elseif(DEFINED flavors_any_${label})
      string(REPLACE "," ";" want "${flavors_any_${label}}")
    elseif(flavors_elsewhere_${label})
      set(want "")  # the phase's tests exist only on other platforms
    else()
      string(APPEND problems "  no 'flavors' line in the map for ${label}\n")
      continue()
    endif()
    foreach(flavor IN LISTS built)
      if(flavor STREQUAL "plain")
        selected_tests(here -L "^${label}$" -LE "^(asan|tsan)$")
      else()
        selected_tests(here -L "^${label}$" -L "^${flavor}$")
      endif()
      list(LENGTH here n)
      if(flavor IN_LIST want AND n EQUAL 0)
        string(APPEND problems "  ${label} has no ${flavor} tests, but the map lists that flavor\n")
      elseif(NOT flavor IN_LIST want AND n GREATER 0)
        string(APPEND problems "  ${label} has ${n} ${flavor} tests, but the map does not list that flavor\n")
      endif()
    endforeach()
  endforeach()
endif()

# A line of the map that matches nothing (a renamed or deleted file or test) must go: it could later give a phase to
# something nobody chose it for.
if(CHECK_UNUSED)
  get_filename_component(root "${MAP}" DIRECTORY)
  get_filename_component(root "${root}/.." ABSOLUTE)
  file(STRINGS "${MAP}" optional_lines REGEX "^testopt:")
  set(optional "")
  foreach(line IN LISTS optional_lines)
    string(REGEX REPLACE "^testopt:([^ \t]+).*$" "\\1" opt "${line}")
    list(APPEND optional "${opt}")
  endforeach()
  list(LENGTH _EPM_REGEXES count)
  math(EXPR last "${count} - 1")
  foreach(i RANGE ${last})
    list(GET _EPM_KINDS ${i} kind)
    list(GET _EPM_PATTERNS ${i} pattern)
    list(GET _EPM_REGEXES ${i} re)
    set(used FALSE)
    if(pattern IN_LIST optional)
      set(used TRUE)
    elseif(kind STREQUAL "test")
      foreach(name IN LISTS all_tests)
        string(REGEX REPLACE "^[0-9]+: " "" name "${name}")
        if(name MATCHES "${re}")
          set(used TRUE)
          break()
        endif()
      endforeach()
    else()
      file(GLOB found "${root}/${pattern}*")
      if(found)
        set(used TRUE)
      endif()
    endif()
    if(NOT used)
      string(APPEND problems "  unused line in the map: ${pattern}\n")
    endif()
  endforeach()
endif()

# No phase of the map is above the current one unless it is a side phase (Phase 26 Day 302): a mistyped phase number on a map line, or a
# phase started without CURRENT_PHASE moving, fails here, on every machine, whether or not this build has the phase's tests.
if(DEFINED CURRENT_PHASE_FILE)
  set(current "")
  if(EXISTS "${CURRENT_PHASE_FILE}")
    file(STRINGS "${CURRENT_PHASE_FILE}" current_lines REGEX "^[ \t]*[^# \t]")
    if(current_lines)
      list(GET current_lines 0 current)
      string(STRIP "${current}" current)
    endif()
  endif()
  if(NOT current MATCHES "^[0-9]+$")
    string(APPEND problems "  ${CURRENT_PHASE_FILE}: '${current}' is not a phase number (the file is missing, empty or holds something else)\n")
  else()
    set(side "")
    if(DEFINED SIDE_PHASES_FILE AND EXISTS "${SIDE_PHASES_FILE}")
      file(STRINGS "${SIDE_PHASES_FILE}" side_lines)
      foreach(line IN LISTS side_lines)
        string(REGEX REPLACE "#.*$" "" line "${line}")
        string(STRIP "${line}" line)
        if(line STREQUAL "")
          continue()
        endif()
        if(NOT line MATCHES "^[0-9]+$")
          string(APPEND problems "  ${SIDE_PHASES_FILE}: '${line}' is not a phase number\n")
          continue()
        endif()
        list(APPEND side "${line}")
      endforeach()
    endif()
    set(map_numbers ${_EPM_PHASES})
    list(REMOVE_DUPLICATES map_numbers)
    # A side phase is above the current one and has lines in the map; an entry that is neither is stale (the phase was closed, or the
    # number is mistyped), as a stale allow-list entry is.
    foreach(n IN LISTS side)
      if(NOT n GREATER current)
        string(APPEND problems "  ${SIDE_PHASES_FILE}: side phase ${n} is not above the current phase ${current} (remove the line when a side phase closes)\n")
      elseif(NOT n IN_LIST map_numbers)
        string(APPEND problems "  ${SIDE_PHASES_FILE}: side phase ${n} has no lines in the map (a mistyped number?)\n")
      endif()
    endforeach()
    foreach(n IN LISTS map_numbers)
      if(n GREATER current AND NOT n IN_LIST side)
        string(APPEND problems "  phase${n} is above the current phase ${current} and is not a side phase (SIDE_PHASES)\n")
      endif()
    endforeach()
  endif()
endif()

if(problems)
  message(FATAL_ERROR "${BUILD_DIR}: every test must have exactly one phase label (tests/phases.txt):\n${problems}")
endif()
message(STATUS "${total} tests, each with exactly one phase label")
