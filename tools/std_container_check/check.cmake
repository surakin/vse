# Standard-container gate (Phase 10 Day 129). Run as:
#   cmake -DROOT=<tree> [-DALLOWLIST=<file>] [-DDIRS="engine;game;tools;..."] -P check.cmake
# Code under engine/, game/, tools/ and the test directories listed as clean may not use the C++ standard library's containers,
# strings, smart pointers, function wrappers, algorithms or streams (std::string, std::vector, std::unique_ptr, std::function,
# std::sort, std::min, #include <vector>, ...), nor spell a fixed-width integer or byte as `unsigned char`, `signed char` or
# `(std::)u?int(8|16|32|64)_t`: the engine has its own (String, StringView, Vector, Array, HashMap, UniquePtr, SharedPtr, Span,
# Sort, Min, Max; byte, u8..u128, i8..i128 in engine/foundation/types.h). Allowed and not checked: the concurrency primitives
# (std::thread, std::mutex, std::atomic, ...), the C library through std:: (std::memcpy, std::snprintf, ...), <cmath>, <new>,
# <type_traits>, <utility>, <limits>, <chrono>, <initializer_list>, std::move/std::forward/std::size_t.
# Comments and string literals are ignored. The allow list is `path|reason` (a trailing `/` covers a directory); an entry that
# exempts nothing is stale and fails the gate, so the list only shrinks. Design: docs/superpowers/specs/2026-11-07-types-and-containers-design.md.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree> [-DALLOWLIST=<file>] [-DDIRS=<list>]")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT ALLOWLIST)
  set(ALLOWLIST "${ROOT}/tools/std_container_check/allowlist.txt")
endif()
if(NOT DIRS)
  # All of tests/ is scanned: a new test directory is checked from its first file. The older directories are allow-listed one by one.
  set(DIRS "engine;game;tools;tests")
endif()

function(read_lines path out)
  file(READ "${path}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" content "${content}")
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

set(allow_paths "")
if(EXISTS "${ALLOWLIST}")
  file(STRINGS "${ALLOWLIST}" allow_lines)
  foreach(line IN LISTS allow_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(FIND "${line}" "|" bar)
    if(bar LESS 1)
      message(SEND_ERROR "${ALLOWLIST}: an entry needs `path|reason`: ${line}")
      continue()
    endif()
    string(SUBSTRING "${line}" 0 ${bar} p)
    math(EXPR after "${bar}+1")
    string(SUBSTRING "${line}" ${after} -1 reason)
    string(STRIP "${reason}" reason)
    if(reason STREQUAL "")
      message(SEND_ERROR "${ALLOWLIST}: the entry for ${p} has no reason")
    endif()
    list(APPEND allow_paths "${p}")
  endforeach()
endif()
set(allow_used "")

set(names "string|string_view|wstring|vector|array|map|multimap|set|multiset|unordered_map|unordered_set|deque|list|forward_list|queue|stack|priority_queue|bitset|unique_ptr|shared_ptr|weak_ptr|make_unique|make_shared|function|optional|variant|span|pair|tuple|to_string|stringstream|ostringstream|istringstream|ifstream|ofstream|sort|stable_sort|find|find_if|min|max|copy|fill|reverse|unique|lower_bound|upper_bound|accumulate|iota|any_of|all_of|none_of|count|count_if|remove_if|transform|swap|clamp|max_element|min_element|cout|cerr|clog|cin|ostream|istream|getline|exchange")
set(name_re "std::(${names})([^A-Za-z0-9_]|$)")
set(int_re "(^|[^A-Za-z0-9_])(unsigned char|signed char|(std::)?u?int(8|16|32|64)_t)([^A-Za-z0-9_]|$)")
set(headers "string|vector|array|map|set|unordered_map|unordered_set|deque|list|queue|stack|memory|functional|optional|variant|span|tuple|algorithm|numeric|sstream|iostream|fstream|filesystem|string_view|bitset")
set(include_re "^[ \t]*#[ \t]*include[ \t]*<(${headers})>")

set(files "")
foreach(dir IN LISTS DIRS)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp" "${ROOT}/${dir}/*.cpp"
       "${ROOT}/${dir}/*.cc" "${ROOT}/${dir}/*.inl" "${ROOT}/${dir}/*.mm" "${ROOT}/${dir}/*.c")
  list(APPEND files ${found})
endforeach()
list(REMOVE_DUPLICATES files)

set(errors 0)
set(scanned 0)
foreach(f IN LISTS files)
  if(f MATCHES "^tools/[^/]+/fixtures/" OR f MATCHES "^engine/platform/linux/wayland/generated/" OR f MATCHES "^fixtures/")
    continue() # data for the tools' own tests, and generated protocol code
  endif()
  math(EXPR scanned "${scanned}+1")
  set(entry -1)
  set(covering "")
  set(i 0)
  foreach(p IN LISTS allow_paths)
    if((p MATCHES "/$" AND f MATCHES "^${p}") OR f STREQUAL p)
      set(entry ${i})
      list(APPEND covering ${i})
    endif()
    math(EXPR i "${i}+1")
  endforeach()
  read_lines("${ROOT}/${f}" lines)
  set(n 0)
  set(in_block FALSE)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    set(code "${l}")
    string(REGEX REPLACE "'([^'\\\\]|\\\\.)'" "''" code "${code}")
    string(REGEX REPLACE "\"([^\"\\\\]|\\\\.)*\"" "\"\"" code "${code}")
    if(in_block)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        continue()
      endif()
      math(EXPR after "${close}+2")
      string(SUBSTRING "${code}" ${after} -1 code)
      set(in_block FALSE)
    endif()
    string(REGEX REPLACE "/\\*[^*]*\\*+([^/*][^*]*\\*+)*/" " " code "${code}")
    string(FIND "${code}" "//" slashes)
    if(NOT slashes LESS 0)
      string(SUBSTRING "${code}" 0 ${slashes} code)
    endif()
    string(FIND "${code}" "/*" open)
    if(NOT open LESS 0)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        string(SUBSTRING "${code}" 0 ${open} code)
        set(in_block TRUE)
      endif()
    endif()
    set(hit FALSE)
    if(code MATCHES "${name_re}" OR code MATCHES "${int_re}" OR l MATCHES "${include_re}")
      set(hit TRUE)
    endif()
    if(NOT hit)
      continue()
    endif()
    if(NOT entry EQUAL -1)
      list(APPEND allow_used ${covering}) # every entry that covers the file is in use
      continue()
    endif()
    string(REPLACE "<LB>" "[" shown "${l}")
    string(REPLACE "<RB>" "]" shown "${shown}")
    string(REPLACE "<SEMI>" ";" shown "${shown}")
    string(STRIP "${shown}" shown)
    message(SEND_ERROR "${f}:${n}: standard container, string, algorithm or raw integer spelling; use the engine's types (String, Vector, UniquePtr, Span, Sort, byte, u8..u128) or add the file to tools/std_container_check/allowlist.txt with a reason: ${shown}")
    math(EXPR errors "${errors}+1")
  endforeach()
endforeach()

set(i 0)
foreach(p IN LISTS allow_paths)
  list(FIND allow_used ${i} found_at)
  if(found_at LESS 0)
    message(SEND_ERROR "${ALLOWLIST}: stale entry ${p}: nothing in it uses a banned type any more; remove it")
    math(EXPR errors "${errors}+1")
  endif()
  math(EXPR i "${i}+1")
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "std_container_check: ${errors} problem(s)")
endif()
message(STATUS "std_container_check: ${scanned} files clean")
