# Container use gate (container audit series, Day 13). Run as:
#   cmake -DROOT=<tree> [-DALLOWLIST=<file>] -P check.cmake
# Fails on two patterns the audit removed, in engine/, game/ and tools/:
# - `.Remove(0)`: a queue drained from the front of a Vector is O(n) per pop; use a Deque.
# - the FNV-1a constants (the prime 1099511628211 / 0x100000001b3, the basis 14695981039346656037 / 0xcbf29ce484222325, any case): hash with
#   Fnv1a64 / Fnv1a64Builder (engine/foundation/containers/hash.h, the one place they are written).
# Exempt: comments, string literals, fixtures and the files in the allow list (`path|reason`; a stale entry fails, so the list only shrinks).
# tests/ is not scanned: its golden hashes and C programs write FNV out by design.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree> [-DALLOWLIST=<file>]")
endif()

set(errors 0)
function(gate_problem text)
  message(NOTICE "error: ${text}")
  math(EXPR count "${errors}+1")
  set(errors ${count} PARENT_SCOPE)
endfunction()

get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT ALLOWLIST)
  set(ALLOWLIST "${ROOT}/tools/container_use_check/allowlist.txt")
endif()

set(allow_paths "")
if(EXISTS "${ALLOWLIST}")
  file(STRINGS "${ALLOWLIST}" allow_lines)
  foreach(line IN LISTS allow_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(FIND "${line}" "|" bar)
    if(bar LESS 1)
      gate_problem("${ALLOWLIST}: an entry needs `path|reason`: ${line}")
      continue()
    endif()
    string(SUBSTRING "${line}" 0 ${bar} p)
    math(EXPR after "${bar}+1")
    string(SUBSTRING "${line}" ${after} -1 reason)
    string(STRIP "${reason}" reason)
    if(reason STREQUAL "")
      gate_problem("${ALLOWLIST}: the entry for ${p} has no reason")
    endif()
    list(APPEND allow_paths "${p}")
  endforeach()
endif()
set(allow_used "")

set(remove0_re "\\.Remove\\(0\\)")
set(fnv_re "(1099511628211|100000001[bB]3|14695981039346656037|[cC][bB][fF]29[cC][eE]484222325)")

set(files "")
foreach(dir engine game tools)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp" "${ROOT}/${dir}/*.cpp" "${ROOT}/${dir}/*.cc"
       "${ROOT}/${dir}/*.inl" "${ROOT}/${dir}/*.mm")
  list(APPEND files ${found})
endforeach()

foreach(f IN LISTS files)
  if(f MATCHES "/fixtures/" OR f MATCHES "/generated/")
    continue()
  endif()
  if(f STREQUAL "engine/foundation/containers/hash.h")
    continue() # the one place the FNV constants are written
  endif()
  set(entry -1)
  set(i 0)
  foreach(p IN LISTS allow_paths)
    if((p MATCHES "/$" AND f MATCHES "^${p}") OR f STREQUAL p)
      set(entry ${i})
    endif()
    math(EXPR i "${i}+1")
  endforeach()
  file(READ "${ROOT}/${f}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" lines "${content}")
  set(n 0)
  set(in_block FALSE)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    set(code "${l}")
    string(REGEX REPLACE "\"([^\"\\\\]|\\\\.)*\"" "\"\"" code "${code}")
    if(in_block)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        continue()
      endif()
      math(EXPR from "${close}+2")
      string(SUBSTRING "${code}" ${from} -1 code)
      set(in_block FALSE)
    endif()
    string(REGEX REPLACE "/\\*.*\\*/" "" code "${code}")
    string(FIND "${code}" "/*" open)
    if(NOT open LESS 0)
      string(SUBSTRING "${code}" 0 ${open} code)
      set(in_block TRUE)
    endif()
    string(FIND "${code}" "//" slash)
    if(NOT slash LESS 0)
      string(SUBSTRING "${code}" 0 ${slash} code)
    endif()
    set(what "")
    if(code MATCHES "${remove0_re}")
      set(what "Remove(0): a queue drained from the front of a Vector; use a Deque")
    elseif(code MATCHES "${fnv_re}")
      set(what "an FNV-1a constant: hash with Fnv1a64 / Fnv1a64Builder (containers/hash.h)")
    endif()
    if(what STREQUAL "")
      continue()
    endif()
    if(entry GREATER -1)
      list(APPEND allow_used ${entry})
      continue()
    endif()
    gate_problem("${f}:${n}: ${what}")
  endforeach()
endforeach()

set(i 0)
foreach(p IN LISTS allow_paths)
  list(FIND allow_used ${i} used)
  if(used LESS 0)
    gate_problem("${ALLOWLIST}: stale entry ${p} (it exempts nothing; remove it)")
  endif()
  math(EXPR i "${i}+1")
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "container_use_check: ${errors} problem(s)")
endif()
message(STATUS "container_use_check: clean")
