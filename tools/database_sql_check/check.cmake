# SQL text gate (Phase 19 Day 252). Run as:
#   cmake -DROOT=<tree> [-DALLOWLIST=<file>] -P check.cmake
# SQL reaches the database interface only as a `SqlText`, which a literal converts to at compile time. `SqlText::Unchecked` is the one way to build
# one from run-time text (a backend building a savepoint statement from a validated name), so it may be named only under a path in the allow list
# (`path-prefix|reason`); tests/ may use it freely. Comments and string literals are exempt. A stale allow-list entry (it exempts nothing) fails.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree> [-DALLOWLIST=<file>]")
endif()

set(errors 0)
function(gate_problem text)
  message(NOTICE "error: ${text}")
  math(EXPR count "${errors}+1")
  set(errors ${count} PARENT_SCOPE)
endfunction()

get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT ALLOWLIST)
  set(ALLOWLIST "${ROOT}/tools/database_sql_check/allowlist.txt")
endif()

set(allow_paths "")
if(EXISTS "${ALLOWLIST}")
  file(STRINGS "${ALLOWLIST}" allow_lines)
  foreach(line IN LISTS allow_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(FIND "${line}" "|" bar)
    if(bar LESS 1)
      gate_problem("${ALLOWLIST}: an entry needs `path|reason`: ${line}")
      continue()
    endif()
    string(SUBSTRING "${line}" 0 ${bar} p)
    math(EXPR after "${bar}+1")
    string(SUBSTRING "${line}" ${after} -1 reason)
    string(STRIP "${reason}" reason)
    if(reason STREQUAL "")
      gate_problem("${ALLOWLIST}: the entry for ${p} has no reason")
    endif()
    list(APPEND allow_paths "${p}")
  endforeach()
endif()
set(allow_used "")

set(files "")
foreach(dir engine game tools)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp" "${ROOT}/${dir}/*.cpp" "${ROOT}/${dir}/*.inl" "${ROOT}/${dir}/*.cc" "${ROOT}/${dir}/*.mm")
  list(APPEND files ${found})
endforeach()

foreach(file IN LISTS files)
  if(file MATCHES "^tools/database_sql_check/")
    continue()
  endif()
  file(STRINGS "${ROOT}/${file}" lines)
  set(number 0)
  foreach(line IN LISTS lines)
    math(EXPR number "${number}+1")
    string(REGEX REPLACE "//.*$" "" code "${line}")
    string(REGEX REPLACE "\"[^\"]*\"" "\"\"" code "${code}")
    if(NOT code MATCHES "(^|[^A-Za-z0-9_])Unchecked[ \t]*\\(")
      continue()
    endif()
    set(allowed FALSE)
    foreach(p IN LISTS allow_paths)
      string(LENGTH "${p}" plen)
      string(SUBSTRING "${file}" 0 ${plen} head)
      if(head STREQUAL p)
        set(allowed TRUE)
        list(APPEND allow_used "${p}")
      endif()
    endforeach()
    if(NOT allowed)
      gate_problem("${file}:${number}: SqlText::Unchecked outside the allow list: ${line}")
    endif()
  endforeach()
endforeach()

foreach(p IN LISTS allow_paths)
  list(FIND allow_used "${p}" at)
  if(at LESS 0)
    gate_problem("stale entry ${p} in ${ALLOWLIST}: nothing under it uses SqlText::Unchecked")
  endif()
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "database_sql_check: ${errors} problem(s)")
endif()
message(STATUS "database_sql_check: ok")
