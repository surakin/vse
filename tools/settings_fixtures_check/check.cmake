# Schema fixture check (Phase 11 Day 136). Run as: cmake -DROOT=<tree> -P settings_fixtures_check.cmake
# For every `SetSchemaVersion("<section>", N)` under engine/ and game/ (the real schemas), the fixture files `<section>_v<k>.cfg` for k = 1 .. N-1 must exist
# in tests/settings/fixtures/ and be listed in SCHEMAS.txt, and tests/settings/migration_test.cpp must name each of them. A new schema version
# without its predecessor's fixture and a migration test fails the build.
cmake_minimum_required(VERSION 3.20)
if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree>")
endif()
set(fixtures "${ROOT}/tests/settings/fixtures")
file(READ "${fixtures}/SCHEMAS.txt" schemas)
file(READ "${ROOT}/tests/settings/migration_test.cpp" migration_test)
# Only code counts: a fixture named in a comment is not loaded by anything.
string(REGEX REPLACE "//[^\n]*" "" migration_test "${migration_test}")
set(errors 0)
set(found "")
foreach(dir engine game)
  file(GLOB_RECURSE sources "${ROOT}/${dir}/*.cpp" "${ROOT}/${dir}/*.h")
  foreach(f IN LISTS sources)
    file(READ "${f}" text)
    string(REGEX MATCHALL "SetSchemaVersion\\(\"[a-z0-9_.]+\", *[0-9]+\\)" calls "${text}")
    string(REGEX MATCHALL "SetSchemaVersion\\(" all_calls "${text}")
    list(LENGTH calls literal_count)
    list(LENGTH all_calls all_count)
    if(all_count GREATER literal_count AND NOT f MATCHES "settings/registry\\.(h|cpp)$")
      message(SEND_ERROR "${f}: SetSchemaVersion must be called with a literal section and version (SetSchemaVersion(\"renderer\", 3)) so this check can see it")
      math(EXPR errors "${errors}+1")
    endif()
    foreach(call IN LISTS calls)
      string(REGEX REPLACE "SetSchemaVersion\\(\"([a-z0-9_.]+)\", *([0-9]+)\\)" "\\1;\\2" parts "${call}")
      list(GET parts 0 section)
      list(GET parts 1 version)
      list(APPEND found "${section}:${version}")
    endforeach()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES found)
foreach(entry IN LISTS found)
  string(REPLACE ":" ";" parts "${entry}")
  list(GET parts 0 section)
  list(GET parts 1 version)
  math(EXPR last "${version}-1")
  if(last LESS 1)
    continue()
  endif()
  foreach(k RANGE 1 ${last})
    set(name "${section}_v${k}.cfg")
    if(NOT EXISTS "${fixtures}/${name}")
      message(SEND_ERROR "schema ${section} is at version ${version}: the fixture ${name} (the file format of schema ${k}) is missing in tests/settings/fixtures")
      math(EXPR errors "${errors}+1")
    endif()
    string(FIND "${schemas}" "${name} ${section} ${k}" listed)
    if(listed LESS 0)
      message(SEND_ERROR "${name} is not listed in tests/settings/fixtures/SCHEMAS.txt as `${name} ${section} ${k}`")
      math(EXPR errors "${errors}+1")
    endif()
    string(FIND "${migration_test}" "\"${name}\"" tested)
    if(tested LESS 0)
      message(SEND_ERROR "tests/settings/migration_test.cpp does not load the fixture ${name}")
      math(EXPR errors "${errors}+1")
    endif()
  endforeach()
endforeach()
if(errors GREATER 0)
  message(FATAL_ERROR "settings_fixtures: ${errors} problem(s)")
endif()
list(LENGTH found count)
message(STATUS "settings_fixtures: ${count} schema(s) checked")
