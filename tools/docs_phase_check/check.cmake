# Documentation phase gate. Run as:
#   cmake -DROOT=<tree> -P check.cmake
# The published documentation never names the project's development phases or days: they only guided the work (plans/, STATUS.md and
# KNOWN-ISSUES.md keep them). Checked: the pages under docs/guide/, docs/tutorials/ and docs/reference/, docs/DOC-CONVENTIONS.md, README.md,
# and the doc comments (`///`, `///<`, `//!`) of the headers under engine/, game/, tools/ and include/ (docs/reference/ is generated from them).
# A reference is `Phase N`, `Phases N`, `Day N` or `Days N` (the word and a number), or the word `Phase` or `Day` ending a line (a wrapped reference).
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree>")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)

set(errors 0)
function(gate_problem text)
  message(NOTICE "error: ${text}")
  math(EXPR count "${errors}+1")
  set(errors ${count} PARENT_SCOPE)
endfunction()

function(read_lines path out)
  file(READ "${path}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" content "${content}")
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

set(ref_re "(^|[^A-Za-z0-9_])(Phases?|Days?) [0-9]+|(^|[^A-Za-z0-9_])(Phase|Day)[ \t]*$")

set(pages "")
foreach(dir docs/guide docs/tutorials docs/reference)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.md" "${ROOT}/${dir}/*.txt")
  list(APPEND pages ${found})
endforeach()
foreach(single docs/DOC-CONVENTIONS.md README.md)
  if(EXISTS "${ROOT}/${single}")
    list(APPEND pages ${single})
  endif()
endforeach()

set(headers "")
foreach(dir engine game tools include)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp")
  list(APPEND headers ${found})
endforeach()

set(scanned 0)
foreach(f IN LISTS pages)
  if(f MATCHES "/fixtures/")
    continue()
  endif()
  math(EXPR scanned "${scanned}+1")
  read_lines("${ROOT}/${f}" lines)
  set(n 0)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    if(l MATCHES "${ref_re}")
      gate_problem("${f}:${n}: names a development phase or day")
    endif()
  endforeach()
endforeach()
foreach(f IN LISTS headers)
  if(f MATCHES "/fixtures/" OR f MATCHES "/generated/" OR f MATCHES "^third_party/")
    continue()
  endif()
  math(EXPR scanned "${scanned}+1")
  read_lines("${ROOT}/${f}" lines)
  set(n 0)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    if(l MATCHES "//[/!]" AND l MATCHES "${ref_re}")
      string(FIND "${l}" "//" at)
      string(SUBSTRING "${l}" ${at} -1 comment)
      if(comment MATCHES "^//[/!]" AND comment MATCHES "${ref_re}")
        gate_problem("${f}:${n}: doc comment names a development phase or day")
      endif()
    endif()
  endforeach()
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "docs_phase_check: ${errors} problem(s) in ${scanned} files")
endif()
message(STATUS "docs_phase_check: ${scanned} files clean")
