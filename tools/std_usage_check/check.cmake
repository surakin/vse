# Standard-library gate (Phase 16 Day 220; replaces std_container_check). Run as:
#   cmake -DROOT=<tree> [-DALLOWLIST=<file>] [-DDIRS="engine;game;tools;tests"] -P check.cmake
# Nothing in engine/, game/, tools/ or tests/ may use the C++ or C standard library directly: no `#include` of a standard header
# (<vector>, <cstring>, <stdio.h>, ...), no `std::` name, no unqualified C library call (strlen(, memcpy(, printf(, ...), and no raw
# `unsigned char`, `signed char` or `(std::)u?int(8|16|32|64)_t` spelling. The engine's own types and wrapper modules replace them
# (docs/guide/foundation-cstr.md, foundation-sync.md, foundation-types.md; PLAN.md assumption #23). Comments and string literals are ignored.
# The allow list has one line per exception: `path|headers|reason`.
#   path     a file, or a directory with a trailing `/` (the wrapper modules, the documented boundaries, the Windows-only files that wait for Day 219)
#   headers  the standard headers the covered files may include, `<a>,<b>`, or `-` for none
#   reason   why; an entry without one fails the gate
# A covered file may spell `std::`, call C library names and use the raw integer spellings freely (that is what a wrapper is), but may include
# only the headers listed for it. An entry that covers no file that uses the standard library, or that lists a header no covered file includes, is
# stale and fails the gate, so the list only shrinks.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree> [-DALLOWLIST=<file>] [-DDIRS=<list>]")
endif()

# Reports one problem and counts it, on one line (message(SEND_ERROR) wraps at the console width, which would make the output depend on the
# length of the checkout's path). A function, not a macro: a macro's arguments are substituted as text. Call it from the top level only.
set(errors 0)
function(gate_problem text)
  message(NOTICE "error: ${text}")
  math(EXPR count "${errors}+1")
  set(errors ${count} PARENT_SCOPE)
endfunction()

get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT ALLOWLIST)
  set(ALLOWLIST "${ROOT}/tools/std_usage_check/allowlist.txt")
endif()
if(NOT DIRS)
  set(DIRS "engine;game;tools;tests")
endif()

function(read_lines path out)
  file(READ "${path}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" content "${content}")
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

# --- the allow list ----------------------------------------------------------------------------------------------------------------
set(allow_paths "")
set(allow_headers "")
if(EXISTS "${ALLOWLIST}")
  file(STRINGS "${ALLOWLIST}" allow_lines)
  foreach(line IN LISTS allow_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(REPLACE "|" ";" parts "${line}")
    list(LENGTH parts nparts)
    if(nparts LESS 3)
      list(GET parts 0 p)
      if(nparts EQUAL 2)
        gate_problem("${ALLOWLIST}: the entry for ${p} has no reason")
      else()
        gate_problem("${ALLOWLIST}: an entry needs `path|headers|reason`: ${line}")
      endif()
      continue()
    endif()
    list(GET parts 0 p)
    list(GET parts 1 h)
    list(GET parts 2 reason)
    string(STRIP "${reason}" reason)
    if(reason STREQUAL "")
      gate_problem("${ALLOWLIST}: the entry for ${p} has no reason")
    endif()
    string(STRIP "${h}" h)
    if(h STREQUAL "-")
      set(h "")
    endif()
    string(REPLACE "," ";" h "${h}")
    list(APPEND allow_paths "${p}")
    list(LENGTH allow_paths idx)
    math(EXPR idx "${idx}-1")
    set(allow_headers_${idx} "${h}")
  endforeach()
endif()
set(allow_used "")
set(header_used "") # "<index>:<header>" pairs seen included by a covered file

# --- what is banned ----------------------------------------------------------------------------------------------------------------
set(std_headers "algorithm|any|array|atomic|bit|bitset|charconv|chrono|codecvt|compare|complex|concepts|condition_variable|coroutine|deque|exception|execution|filesystem|format|forward_list|fstream|functional|future|initializer_list|iomanip|ios|iosfwd|iostream|istream|iterator|latch|limits|list|locale|map|memory|memory_resource|mutex|new|numbers|numeric|optional|ostream|queue|random|ranges|ratio|regex|scoped_allocator|semaphore|set|shared_mutex|source_location|span|sstream|stack|stdexcept|stop_token|streambuf|string|string_view|strstream|syncstream|system_error|thread|tuple|type_traits|typeindex|typeinfo|unordered_map|unordered_set|utility|valarray|variant|vector|version|cassert|cctype|cerrno|cfenv|cfloat|cinttypes|climits|clocale|cmath|csetjmp|csignal|cstdarg|cstddef|cstdint|cstdio|cstdlib|cstring|ctime|cuchar|cwchar|cwctype|assert\\.h|ctype\\.h|errno\\.h|float\\.h|inttypes\\.h|limits\\.h|math\\.h|stdarg\\.h|stddef\\.h|stdint\\.h|stdio\\.h|stdlib\\.h|string\\.h|wchar\\.h")
# `#import` too: Objective-C++ (.mm) accepts it for any header (Phase 26 Day 286).
set(include_re "^[ \t]*#[ \t]*(include|import)[ \t]*<(${std_headers})>")
set(c_names "strlen|strnlen|strcmp|strncmp|strcpy|strncpy|strcat|strncat|strchr|strrchr|strstr|strpbrk|strtok|memcpy|memmove|memset|memcmp|memchr|malloc|calloc|realloc|free|aligned_alloc|printf|fprintf|snprintf|vsnprintf|vfprintf|sprintf|sscanf|puts|fputs|fputc|putchar|fwrite|fread|fopen|fclose|fflush|fgets|getenv|abort|exit|_Exit|atoi|atol|atof|strtol|strtoll|strtoul|strtoull|strtod|strtof|qsort|wcslen|wcscmp|wcsncmp|wcsstr|wcsrchr|wcscat|wmemcpy|wmemmove|swprintf|sqrt|sqrtf|sin|cos|tan|asin|acos|atan|atan2|pow|powf|exp|log|floor|ceil|lround|fabs|fabsf|fmod|ldexp|isnan|isinf|isfinite|signbit|strdup|rand|srand|toupper|tolower|isalpha|isdigit|isalnum|isspace|atexit|system|perror|fseek|ftell|fgetc|getline|setvbuf|assert")
set(c_re "(^|[^A-Za-z0-9_.>:])(::)?(${c_names})[ \t]*\\(")
set(int_re "(^|[^A-Za-z0-9_])(unsigned char|signed char|(std::)?u?int(8|16|32|64)_t)([^A-Za-z0-9_]|$)")
set(prefilter_re "std::|#[ \t]*(include|import)[ \t]*<|unsigned char|signed char|int(8|16|32|64)_t|[^A-Za-z0-9_.>:](::)?(${c_names})[ \t]*\\(")

set(files "")
foreach(dir IN LISTS DIRS)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp" "${ROOT}/${dir}/*.cpp"
       "${ROOT}/${dir}/*.cc" "${ROOT}/${dir}/*.inl" "${ROOT}/${dir}/*.inc" "${ROOT}/${dir}/*.mm" "${ROOT}/${dir}/*.c")
  list(APPEND files ${found})
endforeach()
list(REMOVE_DUPLICATES files)

set(scanned 0)
foreach(f IN LISTS files)
  if(f MATCHES "^tools/[^/]+/fixtures/" OR f MATCHES "^tests/docgen/fixtures/" OR f MATCHES "^engine/platform/linux/wayland/generated/" OR f MATCHES "^fixtures/")
    continue() # data for the tools' own tests, and generated protocol code
  endif()
  math(EXPR scanned "${scanned}+1")
  file(READ "${ROOT}/${f}" whole)
  if(NOT whole MATCHES "${prefilter_re}")
    continue()
  endif()
  set(covering "")
  set(i 0)
  foreach(p IN LISTS allow_paths)
    if((p MATCHES "/$" AND f MATCHES "^${p}") OR f STREQUAL p)
      list(APPEND covering ${i})
    endif()
    math(EXPR i "${i}+1")
  endforeach()
  set(allowed_headers "")
  foreach(c IN LISTS covering)
    list(APPEND allowed_headers ${allow_headers_${c}})
  endforeach()
  read_lines("${ROOT}/${f}" lines)
  set(n 0)
  set(in_block FALSE)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    set(code "${l}")
    string(REGEX REPLACE "'([^'\\\\]|\\\\.)'" "''" code "${code}")
    if(NOT l MATCHES "${include_re}")
      string(REGEX REPLACE "\"([^\"\\\\]|\\\\.)*\"" "\"\"" code "${code}")
    endif()
    if(in_block)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        continue()
      endif()
      math(EXPR after "${close}+2")
      string(SUBSTRING "${code}" ${after} -1 code)
      set(in_block FALSE)
    endif()
    string(REGEX REPLACE "/\\*[^*]*\\*+([^/*][^*]*\\*+)*/" " " code "${code}")
    string(FIND "${code}" "//" slashes)
    if(NOT slashes LESS 0)
      string(SUBSTRING "${code}" 0 ${slashes} code)
    endif()
    string(FIND "${code}" "/*" open)
    if(NOT open LESS 0)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        string(SUBSTRING "${code}" 0 ${open} code)
        set(in_block TRUE)
      endif()
    endif()
    set(kind "")
    set(is_include FALSE)
    if(code MATCHES "${include_re}")
      set(is_include TRUE)
      set(header "<${CMAKE_MATCH_2}>")
      string(REPLACE "\\." "." header "${header}")
      set(kind "standard header ${header}")
    elseif(code MATCHES "std::")
      set(kind "std:: name")
    elseif(code MATCHES "${c_re}")
      set(kind "unqualified C library call")
    elseif(code MATCHES "${int_re}")
      set(kind "raw integer spelling")
    endif()
    if(kind STREQUAL "")
      continue()
    endif()
    list(LENGTH covering covered_by)
    if(covered_by GREATER 0)
      list(APPEND allow_used ${covering}) # every entry that covers the file is in use
      if(is_include)
        list(FIND allowed_headers "${header}" at)
        if(NOT at LESS 0)
          foreach(c IN LISTS covering)
            list(FIND allow_headers_${c} "${header}" cat)
            if(NOT cat LESS 0)
              list(APPEND header_used "${c}:${header}")
            endif()
          endforeach()
          continue()
        endif()
        gate_problem("${f}:${n}: ${kind} is not in the header list of its allow-list entry; use the wrapper module or extend the entry in tools/std_usage_check/allowlist.txt with a reason: ${l}")
      endif()
      continue()
    endif()
    string(REPLACE "<LB>" "[" shown "${l}")
    string(REPLACE "<RB>" "]" shown "${shown}")
    string(REPLACE "<SEMI>" ";" shown "${shown}")
    string(STRIP "${shown}" shown)
    gate_problem("${f}:${n}: ${kind}; use the engine's wrapper types (docs/guide/foundation-cstr.md, foundation-sync.md, foundation-types.md) or add the file to tools/std_usage_check/allowlist.txt with a reason: ${shown}")
  endforeach()
endforeach()

# --- stale entries -----------------------------------------------------------------------------------------------------------------
set(i 0)
foreach(p IN LISTS allow_paths)
  list(FIND allow_used ${i} found_at)
  if(found_at LESS 0)
    gate_problem("${ALLOWLIST}: stale entry ${p}: nothing in it uses the standard library any more; remove it")
  else()
    foreach(h IN LISTS allow_headers_${i})
      list(FIND header_used "${i}:${h}" hat)
      if(hat LESS 0)
        gate_problem("${ALLOWLIST}: stale header ${h} in the entry for ${p}: no covered file includes it; remove it from the entry")
      endif()
    endforeach()
  endif()
  math(EXPR i "${i}+1")
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "std_usage_check: ${errors} problem(s)")
endif()
message(STATUS "std_usage_check: ${scanned} files clean")
