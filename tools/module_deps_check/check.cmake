# Module dependency gate (Phase 12 Day 141). Run as:
#   cmake -DROOT=<tree> -DMODULES=<modules.txt> -DALLOWLIST=<allowlist.txt> [-DMIN_EDGES=<n>] -P check.cmake
#
# ARCHITECTURE.md says a module includes and links only modules in lower layers (or ones its row allows), never one above, with no
# cycles. This script measures that on the tree:
#
#   1. every `#include "..."` of a source under the `scan` directories is resolved the way the compiler does (the including file's
#      own directory first, then the `include-dir` list in order) and both files are mapped to modules by modules.txt;
#   2. an edge between two different modules is a violation if it goes up (the target's layer is higher), stays in a layer without
#      an `allow` line (or `same-layer-ok`), or is `forbid`den;
#   3. a file outside the owner directories of a `platform-dir` may not include a file under it, and a file outside every
#      `platform-dir` (neutral code) may not include a system header that a `platform-header` line names (windows.h, X11, xkbcommon,
#      Wayland, D3D12, DXGI, the platform Vulkan surface headers; Phase 13 Day 150);
#   4. a quoted include that resolves nowhere and is not a `system-include` is an error;
#   5. the same edge rules apply to the CMake `target_link_libraries` lines (targets mapped by `target` lines), and a `syslib` may
#      be linked only by its module's targets;
#   6. the violations that are known and scheduled are in allowlist.txt, one line each: `<kind> <from> -> <to> | <reason> |
#      <day that removes it>` with kind edge, platform or syslib. An entry that matches no violation (it was fixed) is stale and
#      fails, and so does one without a reason or a day. What the allow list covers is removed from the graph, and what is left must
#      have no cycle.
#
# Output lines: `module_deps_check: <kind>: <from> (<layer>) -> <to> (<layer>): <file>:<line>`; the last line counts the problems.
# MIN_EDGES is a floor on the number of distinct module edges found: a gate that resolved nothing must not pass.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT OR NOT MODULES OR NOT ALLOWLIST)
  message(FATAL_ERROR "usage: -DROOT=<tree> -DMODULES=<file> -DALLOWLIST=<file> [-DMIN_EDGES=<n>]")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
get_filename_component(MODULES "${MODULES}" ABSOLUTE)
get_filename_component(ALLOWLIST "${ALLOWLIST}" ABSOLUTE)

set(problems 0)
# A function, not a macro: a macro's arguments are substituted into its body as text and evaluated again, so a `\` or `${x}` in a
# reported include would be mangled (Phase 13 Day 150 review). Call it from the top level only (it counts in its caller's scope).
function(problem text)
  message(STATUS "module_deps_check: ${text}")
  math(EXPR count "${problems}+1")
  set(problems ${count} PARENT_SCOPE)
endfunction()

function(read_lines path out)
  file(READ "${path}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" content "${content}")
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

# Variable-name-safe form of a module name.
function(key name out)
  string(MAKE_C_IDENTIFIER "${name}" k)
  string(REPLACE "/" "_S_" k "${name}")
  string(MAKE_C_IDENTIFIER "${k}" k)
  set(${out} "${k}" PARENT_SCOPE)
endfunction()

# --- modules.txt ----------------------------------------------------------------------------------------------------------
set(scan_dirs "")
set(excludes "")
set(include_dirs "")
set(system_includes "")
set(mod_paths "")
set(mod_names "")
set(mod_layers "")
set(same_layer_ok "")
set(allow_pairs "")
set(forbid_pairs "")
set(platform_dirs "")
set(platform_owners "")
set(target_names "")
set(target_modules "")
set(syslib_prefixes "")
set(syslib_modules "")
set(platform_headers "")

read_lines("${MODULES}" lines)
foreach(line IN LISTS lines)
  string(REGEX REPLACE "#.*$" "" line "${line}")
  string(STRIP "${line}" line)
  if(line STREQUAL "")
    continue()
  endif()
  string(REGEX REPLACE "[ \t]+" ";" w "${line}")
  list(LENGTH w n)
  list(GET w 0 directive)
  if(directive STREQUAL "scan" AND n EQUAL 2)
    list(GET w 1 v)
    list(APPEND scan_dirs "${v}")
  elseif(directive STREQUAL "exclude" AND n EQUAL 2)
    list(GET w 1 v)
    list(APPEND excludes "${v}")
  elseif(directive STREQUAL "include-dir" AND n EQUAL 2)
    list(GET w 1 v)
    list(APPEND include_dirs "${v}")
  elseif(directive STREQUAL "system-include" AND n EQUAL 2)
    list(GET w 1 v)
    list(APPEND system_includes "${v}")
  elseif(directive STREQUAL "module" AND n EQUAL 4)
    list(GET w 1 p)
    list(GET w 2 m)
    list(GET w 3 l)
    list(APPEND mod_paths "${p}")
    list(APPEND mod_names "${m}")
    list(APPEND mod_layers "${l}")
    key("${m}" mk)
    set(layer_of_${mk} "${l}")
  elseif(directive STREQUAL "layer" AND n EQUAL 3)
    list(GET w 1 m)
    list(GET w 2 l)
    key("${m}" mk)
    set(layer_of_${mk} "${l}")
  elseif(directive STREQUAL "same-layer-ok" AND n EQUAL 2)
    list(GET w 1 v)
    list(APPEND same_layer_ok "${v}")
  elseif(directive STREQUAL "allow" AND n EQUAL 3)
    list(GET w 1 a)
    list(GET w 2 b)
    list(APPEND allow_pairs "${a}->${b}")
  elseif(directive STREQUAL "forbid" AND n EQUAL 3)
    list(GET w 1 a)
    list(GET w 2 b)
    list(APPEND forbid_pairs "${a}->${b}")
  elseif(directive STREQUAL "platform-dir" AND n EQUAL 3)
    list(GET w 1 d)
    list(GET w 2 o)
    list(APPEND platform_dirs "${d}")
    string(REPLACE "," "|" o "${o}")
    list(APPEND platform_owners "${o}")
  elseif(directive STREQUAL "target" AND n EQUAL 3)
    list(GET w 1 t)
    list(GET w 2 m)
    list(APPEND target_names "${t}")
    list(APPEND target_modules "${m}")
  elseif(directive STREQUAL "platform-header" AND n EQUAL 2)
    list(GET w 1 re)
    list(APPEND platform_headers "${re}")
  elseif(directive STREQUAL "syslib" AND n EQUAL 3)
    list(GET w 1 p)
    list(GET w 2 m)
    list(APPEND syslib_prefixes "${p}")
    list(APPEND syslib_modules "${m}")
  else()
    message(SEND_ERROR "modules.txt: cannot read line: ${line}")
  endif()
endforeach()

# A target or syslib owner whose module has no layer would compare as "not higher" and pass every rule: refuse it.
foreach(m IN LISTS target_modules syslib_modules)
  key("${m}" mk)
  if("${layer_of_${mk}}" STREQUAL "")
    problem("modules.txt: the module '${m}' (named by a target or syslib line) has no layer; give it a `module` or `layer` line")
  endif()
endforeach()

# The module and layer of a root-relative path (longest matching `module` path wins); sets `module_name` and `module_layer`,
# empty when nothing matches. Cached per path.
macro(map_path rel)
  set(module_name "")
  set(module_layer "")
  if(DEFINED mapcache_${rel})
    list(GET mapcache_${rel} 0 module_name)
    list(GET mapcache_${rel} 1 module_layer)
  else()
    set(best -1)
    set(i 0)
    foreach(p IN LISTS mod_paths)
      string(LENGTH "${p}" plen)
      string(FIND "${rel}" "${p}" at)
      if(at EQUAL 0 AND plen GREATER best)
        set(hit FALSE)
        if(p MATCHES "/$" OR "${rel}" STREQUAL "${p}")
          set(hit TRUE)
        endif()
        if(hit)
          set(best ${plen})
          list(GET mod_names ${i} module_name)
          list(GET mod_layers ${i} module_layer)
        endif()
      endif()
      math(EXPR i "${i}+1")
    endforeach()
    set(mapcache_${rel} "${module_name};${module_layer}")
  endif()
endmacro()

# --- allowlist.txt ---------------------------------------------------------------------------------------------------------
set(allow_keys "")
read_lines("${ALLOWLIST}" lines)
foreach(line IN LISTS lines)
  string(REGEX REPLACE "^[ \t]*#.*$" "" line "${line}")
  string(STRIP "${line}" line)
  if(line STREQUAL "")
    continue()
  endif()
  string(REPLACE "|" ";" parts "${line}")
  list(LENGTH parts np)
  list(GET parts 0 head)
  string(STRIP "${head}" head)
  if(NOT head MATCHES "^(edge|platform|syslib|header) ([^ ]+) -> ([^ ]+)$")
    problem("allow list: cannot read the entry (kind from -> to): ${line}")
    continue()
  endif()
  set(kind "${CMAKE_MATCH_1}")
  set(from "${CMAKE_MATCH_2}")
  set(to "${CMAKE_MATCH_3}")
  set(reason "")
  set(day "")
  if(np GREATER 1)
    list(GET parts 1 reason)
    string(STRIP "${reason}" reason)
  endif()
  if(np GREATER 2)
    list(GET parts 2 day)
    string(STRIP "${day}" day)
  endif()
  if(reason STREQUAL "" OR day STREQUAL "")
    problem("allow list: the entry '${head}' needs a reason and the day that removes it (kind from -> to | reason | day)")
  endif()
  list(APPEND allow_keys "${kind} ${from} -> ${to}")
endforeach()
set(allow_used "")

# --- the sources -----------------------------------------------------------------------------------------------------------
set(sources "")
foreach(d IN LISTS scan_dirs)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${d}/*.h" "${ROOT}/${d}/*.hpp" "${ROOT}/${d}/*.cpp" "${ROOT}/${d}/*.c" "${ROOT}/${d}/*.inc"
       "${ROOT}/${d}/*.mm")
  list(APPEND sources ${found})
endforeach()
list(SORT sources)

# edge_<from>__<to> holds up to 3 "file|include" examples, edges lists every pair "from->to".
set(edges "")
set(edge_total 0)
set(unmapped "")
set(unresolved "")
set(platform_hits "")
set(header_hits "")

foreach(f IN LISTS sources)
  set(skip FALSE)
  foreach(x IN LISTS excludes)
    string(FIND "/${f}" "${x}" at)
    if(NOT at LESS 0)
      set(skip TRUE)
    endif()
  endforeach()
  if(skip)
    continue()
  endif()
  map_path("${f}")
  if(module_name STREQUAL "")
    list(APPEND unmapped "${f}")
    continue()
  endif()
  set(from "${module_name}")
  set(from_layer "${module_layer}")
  # A neutral file (under no platform-dir) may not include a platform system header.
  set(neutral TRUE)
  foreach(pd IN LISTS platform_dirs)
    string(FIND "${f}" "${pd}" at)
    if(at EQUAL 0)
      set(neutral FALSE)
    endif()
  endforeach()
  if(neutral AND platform_headers)
    file(STRINGS "${ROOT}/${f}" sys_incs REGEX "^[ \t]*#[ \t]*(include|import)[ \t]*<[^>]+>")
    foreach(sys_line IN LISTS sys_incs)
      string(REGEX REPLACE "^[ \t]*#[ \t]*(include|import)[ \t]*<([^>]+)>.*$" "\\2" sys_inc "${sys_line}")
      foreach(re IN LISTS platform_headers)
        if(sys_inc MATCHES "${re}")
          list(APPEND header_hits "${f}|${sys_inc}")
          break()
        endif()
      endforeach()
    endforeach()
  endif()
  # `#import` too: Objective-C++ (.mm) accepts it (Phase 26 Day 286).
  file(STRINGS "${ROOT}/${f}" incs REGEX "^[ \t]*#[ \t]*(include|import)[ \t]*\"[^\"]+\"")
  get_filename_component(fdir "${f}" DIRECTORY)
  foreach(inc_line IN LISTS incs)
    string(REGEX REPLACE "^[ \t]*#[ \t]*(include|import)[ \t]*\"([^\"]+)\".*$" "\\2" inc "${inc_line}")
    set(target_rel "")
    foreach(base "${fdir}" ${include_dirs})
      if(EXISTS "${ROOT}/${base}/${inc}")
        get_filename_component(abs "${ROOT}/${base}/${inc}" ABSOLUTE)
        file(RELATIVE_PATH target_rel "${ROOT}" "${abs}")
        break()
      endif()
    endforeach()
    if(target_rel STREQUAL "")
      set(is_system FALSE)
      foreach(re IN LISTS system_includes)
        if(inc MATCHES "${re}")
          set(is_system TRUE)
        endif()
      endforeach()
      if(NOT is_system)
        list(APPEND unresolved "${f}|${inc}")
      endif()
      continue()
    endif()
    map_path("${target_rel}")
    if(module_name STREQUAL "")
      list(APPEND unmapped "${target_rel}")
      continue()
    endif()
    set(to "${module_name}")
    # Per-platform directories.
    set(i 0)
    foreach(pd IN LISTS platform_dirs)
      string(FIND "${target_rel}" "${pd}" at)
      if(at EQUAL 0)
        list(GET platform_owners ${i} owners)
        string(REPLACE "|" ";" owners "${owners}")
        set(owned FALSE)
        foreach(o IN LISTS owners pd)
          string(FIND "${f}" "${o}" at2)
          if(at2 EQUAL 0)
            set(owned TRUE)
          endif()
        endforeach()
        if(NOT owned)
          list(APPEND platform_hits "${from}|${to}|${f}|${inc}")
        endif()
      endif()
      math(EXPR i "${i}+1")
    endforeach()
    if(NOT from STREQUAL to)
      key("${from}" fk)
      key("${to}" tk)
      if(NOT DEFINED edge_${fk}__${tk})
        set(edge_${fk}__${tk} "")
        list(APPEND edges "${from}->${to}")
        math(EXPR edge_total "${edge_total}+1")
      endif()
      list(LENGTH edge_${fk}__${tk} have)
      if(have LESS 3)
        list(APPEND edge_${fk}__${tk} "${f}|${inc}")
      endif()
    endif()
  endforeach()
endforeach()

# --- link lines ------------------------------------------------------------------------------------------------------------
set(link_edges "")
set(link_examples "")
set(syslib_hits "")
set(link_unmapped "")
foreach(d IN LISTS scan_dirs)
  file(GLOB_RECURSE cmake_files RELATIVE "${ROOT}" "${ROOT}/${d}/CMakeLists.txt")
  foreach(cf IN LISTS cmake_files)
    set(skip FALSE)
    foreach(x IN LISTS excludes)
      string(FIND "/${cf}" "${x}" at)
      if(NOT at LESS 0)
        set(skip TRUE)
      endif()
    endforeach()
    if(skip)
      continue()
    endif()
    file(READ "${ROOT}/${cf}" text)
    string(REGEX REPLACE "#[^\n]*" "" text "${text}")
    # Every library and executable needs a module.
    string(REGEX MATCHALL "add_(library|executable)[ \t\n]*\\([ \t\n]*[A-Za-z0-9_]+" decls "${text}")
    foreach(decl IN LISTS decls)
      string(REGEX REPLACE "^.*\\([ \t\n]*" "" tname "${decl}")
      string(REGEX REPLACE "(_asan|_tsan)$" "" base_name "${tname}")
      list(FIND target_names "${base_name}" at)
      if(at LESS 0)
        list(APPEND link_unmapped "${cf}|${tname}")
      endif()
    endforeach()
    string(REGEX MATCHALL "target_link_libraries[ \t\n]*\\([^)]*\\)" calls "${text}")
    foreach(call IN LISTS calls)
      string(REGEX REPLACE "^target_link_libraries[ \t\n]*\\([ \t\n]*" "" body "${call}")
      string(REGEX REPLACE "[ \t\n]*\\)$" "" body "${body}")
      string(REGEX REPLACE "[ \t\r\n]+" ";" items "${body}")
      list(GET items 0 tname)
      list(REMOVE_AT items 0)
      string(REPLACE "\${suffix}" "" tname "${tname}")
      string(REGEX REPLACE "(_asan|_tsan)$" "" tbase "${tname}")
      list(FIND target_names "${tbase}" tat)
      if(tat LESS 0)
        continue()
      endif()
      list(GET target_modules ${tat} from)
      foreach(item IN LISTS items)
        if(item MATCHES "^(PUBLIC|PRIVATE|INTERFACE)$")
          continue()
        endif()
        string(REPLACE "\${suffix}" "" item "${item}")
        if(item MATCHES "\\$")
          continue()
        endif()
        set(sat -1)
        set(si 0)
        foreach(sp IN LISTS syslib_prefixes)
          if(item STREQUAL sp)
            set(sat ${si})
          endif()
          math(EXPR si "${si}+1")
        endforeach()
        if(NOT sat LESS 0)
          list(GET syslib_modules ${sat} owner)
          if(NOT from STREQUAL owner)
            list(APPEND syslib_hits "${from}|${item}|${cf}")
          endif()
          continue()
        endif()
        string(REGEX REPLACE "(_asan|_tsan)$" "" ibase "${item}")
        list(FIND target_names "${ibase}" iat)
        if(iat LESS 0)
          continue()
        endif()
        list(GET target_modules ${iat} to)
        if(NOT from STREQUAL to)
          list(APPEND link_edges "${from}->${to}")
          list(APPEND link_examples "${from}->${to}|${cf}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES link_edges)

# --- judging the edges -----------------------------------------------------------------------------------------------------
# Returns in `verdict` why from->to is not allowed, or empty. Reads the layers through layer_of_<key>.
macro(judge from to)
  set(verdict "")
  key("${from}" jfk)
  key("${to}" jtk)
  set(jfl "${layer_of_${jfk}}")
  set(jtl "${layer_of_${jtk}}")
  if("${from}->${to}" IN_LIST forbid_pairs)
    set(verdict "forbidden")
  elseif(jtl GREATER jfl)
    set(verdict "upward")
  elseif(jtl EQUAL jfl)
    if(NOT "${from}->${to}" IN_LIST allow_pairs AND NOT jfl IN_LIST same_layer_ok)
      set(verdict "same layer")
    endif()
  endif()
endmacro()

set(graph_edges "")   # edges kept after the allow list, for the cycle search
set(all_edges ${edges})
foreach(e IN LISTS link_edges)
  list(APPEND all_edges "${e}")
endforeach()
list(REMOVE_DUPLICATES all_edges)

foreach(e IN LISTS all_edges)
  string(REPLACE "->" ";" ab "${e}")
  list(GET ab 0 a)
  list(GET ab 1 b)
  judge("${a}" "${b}")
  set(is_link FALSE)
  if(e IN_LIST link_edges)
    set(is_link TRUE)
  endif()
  if(verdict STREQUAL "")
    list(APPEND graph_edges "${e}")
    continue()
  endif()
  set(allow_key "edge ${a} -> ${b}")
  if(allow_key IN_LIST allow_keys)
    list(APPEND allow_used "${allow_key}")
    continue()
  endif()
  list(APPEND graph_edges "${e}")
  key("${a}" ak)
  key("${b}" bk)
  set(shown FALSE)
  if(DEFINED edge_${ak}__${bk})
    foreach(ex IN LISTS edge_${ak}__${bk})
      string(REPLACE "|" ";" fi "${ex}")
      list(GET fi 0 ef)
      list(GET fi 1 ei)
      # The line number is found only for a violation: reading the file line by line is slow.
      read_lines("${ROOT}/${ef}" flines)
      set(ln 0)
      set(found_ln 0)
      foreach(fl IN LISTS flines)
        math(EXPR ln "${ln}+1")
        if(found_ln EQUAL 0 AND fl MATCHES "(include|import)[ \t]*\"${ei}\"")
          set(found_ln ${ln})
        endif()
      endforeach()
      problem("${verdict} include: ${a} (${jfl}) -> ${b} (${jtl}): ${ef}:${found_ln}")
      set(shown TRUE)
    endforeach()
  endif()
  if(is_link)
    foreach(ex IN LISTS link_examples)
      string(REPLACE "|" ";" fi "${ex}")
      list(GET fi 0 pair)
      list(GET fi 1 cf)
      if(pair STREQUAL e)
        problem("${verdict} link: ${a} (${jfl}) -> ${b} (${jtl}): ${cf}")
        set(shown TRUE)
        break()
      endif()
    endforeach()
  endif()
endforeach()

# Platform-directory includes.
set(platform_pairs "")
foreach(h IN LISTS platform_hits)
  string(REPLACE "|" ";" p "${h}")
  list(GET p 0 a)
  list(GET p 1 b)
  list(GET p 2 pf)
  list(GET p 3 pi)
  set(allow_key "platform ${a} -> ${b}")
  if(allow_key IN_LIST allow_keys)
    list(APPEND allow_used "${allow_key}")
    continue()
  endif()
  read_lines("${ROOT}/${pf}" flines)
  set(ln 0)
  set(found_ln 0)
  foreach(fl IN LISTS flines)
    math(EXPR ln "${ln}+1")
    if(found_ln EQUAL 0 AND fl MATCHES "(include|import)[ \t]*\"${pi}\"")
      set(found_ln ${ln})
    endif()
  endforeach()
  problem("platform include: ${a} -> ${b}: ${pf}:${found_ln} includes the per-platform file ${pi}")
endforeach()

# Platform system headers in neutral files.
foreach(h IN LISTS header_hits)
  string(REPLACE "|" ";" p "${h}")
  list(GET p 0 hf)
  list(GET p 1 hi)
  set(allow_key "header ${hf} -> ${hi}")
  if(allow_key IN_LIST allow_keys)
    list(APPEND allow_used "${allow_key}")
    continue()
  endif()
  read_lines("${ROOT}/${hf}" flines)
  set(ln 0)
  set(found_ln 0)
  foreach(fl IN LISTS flines)
    math(EXPR ln "${ln}+1")
    if(found_ln EQUAL 0 AND fl MATCHES "(include|import)[ \t]*<${hi}>")
      set(found_ln ${ln})
    endif()
  endforeach()
  problem("platform header: ${hf}:${found_ln} includes <${hi}>, which only per-platform code (a platform-dir) may include")
endforeach()

# System libraries.
list(REMOVE_DUPLICATES syslib_hits)
foreach(h IN LISTS syslib_hits)
  string(REPLACE "|" ";" p "${h}")
  list(GET p 0 a)
  list(GET p 1 lib)
  list(GET p 2 cf)
  set(allow_key "syslib ${a} -> ${lib}")
  if(allow_key IN_LIST allow_keys)
    list(APPEND allow_used "${allow_key}")
    continue()
  endif()
  problem("system library: ${a} links ${lib}: ${cf}")
endforeach()

# Unresolved includes, unmapped files and unmapped targets.
foreach(u IN LISTS unresolved)
  string(REPLACE "|" ";" p "${u}")
  list(GET p 0 uf)
  list(GET p 1 ui)
  problem("unresolved include \"${ui}\" in ${uf} (not found in the file's directory or the include-dir list, and not a system-include)")
endforeach()
list(REMOVE_DUPLICATES unmapped)
foreach(u IN LISTS unmapped)
  problem("no module for ${u} (add a `module` line to modules.txt)")
endforeach()
foreach(u IN LISTS link_unmapped)
  string(REPLACE "|" ";" p "${u}")
  list(GET p 0 uf)
  list(GET p 1 ut)
  problem("no module for the CMake target ${ut} in ${uf} (add a `target` line to modules.txt)")
endforeach()

# Stale allow-list entries.
foreach(k IN LISTS allow_keys)
  if(NOT k IN_LIST allow_used)
    problem("stale allow-list entry: ${k} (no such violation any more; delete the line)")
  endif()
endforeach()

# --- cycles in what is left --------------------------------------------------------------------------------------------------
# A module is on a cycle if it can reach itself. Reachability by repeated relaxation over the (small) module graph.
set(nodes "")
foreach(e IN LISTS graph_edges)
  string(REPLACE "->" ";" ab "${e}")
  list(GET ab 0 a)
  list(GET ab 1 b)
  list(APPEND nodes "${a}" "${b}")
endforeach()
list(REMOVE_DUPLICATES nodes)
foreach(n IN LISTS nodes)
  key("${n}" nk)
  set(reach_${nk} "")
endforeach()
foreach(e IN LISTS graph_edges)
  string(REPLACE "->" ";" ab "${e}")
  list(GET ab 0 a)
  list(GET ab 1 b)
  key("${a}" ak)
  list(APPEND reach_${ak} "${b}")
endforeach()
set(changed TRUE)
while(changed)
  set(changed FALSE)
  foreach(n IN LISTS nodes)
    key("${n}" nk)
    set(before "${reach_${nk}}")
    foreach(m IN LISTS before)
      key("${m}" mk)
      foreach(x IN LISTS reach_${mk})
        if(NOT x IN_LIST reach_${nk})
          list(APPEND reach_${nk} "${x}")
          set(changed TRUE)
        endif()
      endforeach()
    endforeach()
  endforeach()
endwhile()
set(on_cycle "")
foreach(n IN LISTS nodes)
  key("${n}" nk)
  if(n IN_LIST reach_${nk})
    list(APPEND on_cycle "${n}")
  endif()
endforeach()
if(on_cycle)
  string(REPLACE ";" ", " shown_cycle "${on_cycle}")
  problem("cycle: these modules reach themselves through includes or links: ${shown_cycle}")
endif()

# --- the floor ---------------------------------------------------------------------------------------------------------------
if(MIN_EDGES AND edge_total LESS MIN_EDGES)
  problem("only ${edge_total} module edges were found, the floor is ${MIN_EDGES}: the gate is not resolving includes")
endif()

message(STATUS "module_deps_check: ${edge_total} module edges from includes, ${problems} problem(s)")
if(problems GREATER 0)
  message(FATAL_ERROR "module_deps_check failed")
endif()
