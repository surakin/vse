# Shared-state gate (Phase 23 Day 345). Run as:
#   cmake -DROOT=<tree> [-DALLOWLIST=<allowlist.txt>] -P check.cmake
# The engine library is one binary with one copy of every singleton. A header is compiled into every library that includes it, and under
# hidden visibility each gets its own copy of any non-const object the header defines: a second log, allocator or counter that nothing
# else sees (Phase 23 spec, Spike 2). So a public header under engine/ defines no mutable static state. Rules, over every .h under engine/
# (the planted fixtures of tools/*/fixtures excepted); comments and strings are ignored:
#   1. `static` (function scope or class member, `static inline` included) whose declaration is a non-const, non-constexpr object (`const` as the
#      first specifier, `constexpr`, or a pointer's own `* const` make it constant; `static Vector<const char*> names;` is still mutable).
#   2. `thread_local` anywhere (a header's thread-local is one per library and registers a destructor on the host's threads).
#   3. `inline` non-const, non-constexpr variable at namespace scope.
# Move the object into the `.cpp` of its module (one definition, inside the library), or list the header in allowlist.txt with the reason
# it is safe (`path|reason`); an entry that exempts nothing is stale and fails.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree>")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
get_filename_component(SELF_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
if(NOT ALLOWLIST)
  set(ALLOWLIST "${SELF_DIR}/allowlist.txt")
endif()

set(errors 0)
function(gate_problem text)
  message(NOTICE "error: ${text}")
  math(EXPR count "${errors}+1")
  set(errors ${count} PARENT_SCOPE)
endfunction()

set(allowed "")
set(allowed_used "")
if(EXISTS "${ALLOWLIST}")
  file(STRINGS "${ALLOWLIST}" allow_lines)
  foreach(line IN LISTS allow_lines)
    if(line MATCHES "^[ \t]*#" OR line MATCHES "^[ \t]*$")
      continue()
    endif()
    if(NOT line MATCHES "^([^|]+)\\|(.+)$")
      gate_problem("${ALLOWLIST}: an entry needs `path|reason`: ${line}")
      continue()
    endif()
    list(APPEND allowed "${CMAKE_MATCH_1}")
  endforeach()
endif()

file(GLOB_RECURSE files RELATIVE "${ROOT}" "${ROOT}/engine/*.h")
list(SORT files)

# The shapes of a line of code (comments and strings already removed).
set(static_re "^[ \t]*((inline|static|thread_local)[ \t]+)+")
set(object_end_re "(=[^=]|\\{[^}]*\\}|<SEMI>)")

foreach(f IN LISTS files)
  if(f MATCHES "^engine/third_party/" OR (f MATCHES "^tools/[^/]+/fixtures/" AND NOT ROOT MATCHES "/fixtures/"))
    continue()
  endif()
  file(READ "${ROOT}/${f}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REGEX REPLACE "\\\\[ \t]*\n" " \n" content "${content}")  # a macro's continuation line ends the line for this check
  string(REPLACE "\n" ";" content "${content}")
  set(n 0)
  set(in_block FALSE)
  set(stack "")  # one of `T` (a class, struct or union body) or `O` (anything else) per open brace
  set(prev_code "")
  foreach(l IN LISTS content)
    math(EXPR n "${n}+1")
    set(code "${l}")
    string(REGEX REPLACE "\"([^\"\\\\]|\\\\.)*\"" "\"\"" code "${code}")
    if(in_block)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        continue()
      endif()
      math(EXPR after "${close}+2")
      string(SUBSTRING "${code}" ${after} -1 code)
      set(in_block FALSE)
    endif()
    # Whichever of `//` and `/*` comes first decides (a `/*` inside a line comment opens nothing).
    string(FIND "${code}" "//" line_at)
    string(FIND "${code}" "/*" open)
    if(NOT line_at LESS 0 AND (open LESS 0 OR line_at LESS open))
      string(SUBSTRING "${code}" 0 ${line_at} code)
    else()
      string(REGEX REPLACE "/\\*[^*]*\\*/" " " code "${code}")
      string(FIND "${code}" "/*" open)
      if(NOT open LESS 0)
        string(SUBSTRING "${code}" 0 ${open} code)
        set(in_block TRUE)
      endif()
    endif()
    string(REGEX REPLACE "[ \t\\\\]+$" "" code "${code}")
    if(code STREQUAL "")
      continue()
    endif()

    set(why "")
    if(code MATCHES "(^|[^A-Za-z0-9_])thread_local([^A-Za-z0-9_]|$)")
      set(why "a thread_local")
    elseif(code MATCHES "${static_re}" AND NOT code MATCHES "^[ \t]*((inline|static|thread_local)[ \t]+)*(constexpr|const|constinit)[ \t]" AND NOT code MATCHES "\\*[ \t]*const[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*(=|\\{|<SEMI>)" AND NOT code MATCHES "^[ \t]*static_assert")
      # A function, or a static member function, has a parenthesis before any `=` or brace; an object does not (a macro's brace-initializer
      # may contain calls, so the test is on the text before the first `{` or `=`).
      string(REGEX REPLACE "(=|\\{).*$" "" head "${code}")
      if(NOT head MATCHES "\\(" AND NOT head MATCHES "(^|[^A-Za-z0-9_])(class|struct|enum|union|using|typedef|template|namespace|friend|operator)([^A-Za-z0-9_]|$)" AND
         code MATCHES "${object_end_re}" AND NOT code MATCHES "^[ \t]*(inline|static)[ \t]+(inline[ \t]+)?[A-Za-z_:<>0-9, ]+[ \t]*\\(")
        # Inside a class body a `static T name;` without `inline` only declares the member (defined in a .cpp).
        string(SUBSTRING "${stack}" 0 1 top)
        if(NOT top STREQUAL "T" OR code MATCHES "(^|[^A-Za-z0-9_])inline([^A-Za-z0-9_]|$)")
          set(why "a non-const static object")
        endif()
      endif()
    elseif(code MATCHES "^[ \t]*inline[ \t]+" AND NOT code MATCHES "(^|[^A-Za-z0-9_])(constexpr|const|constinit)([^A-Za-z0-9_]|$)")
      string(REGEX REPLACE "(=|\\{).*$" "" head "${code}")
      if(NOT head MATCHES "\\(" AND NOT head MATCHES "(^|[^A-Za-z0-9_])(class|struct|enum|union|using|namespace|template|operator)([^A-Za-z0-9_]|$)" AND
         code MATCHES "${object_end_re}")
        set(why "a non-const inline variable")
      endif()
    endif()
    if(NOT why STREQUAL "")
      list(FIND allowed "${f}" at)
      if(at LESS 0)
        gate_problem("${f}:${n}: ${why}: a header must not define mutable state (move it into the module's .cpp, or allow-list the header with a reason)")
      else()
        list(APPEND allowed_used "${f}")
      endif()
    endif()

    # Track the braces: the line's own text decides the kind of a `{` on it, a lone `{` takes the kind from the line before (Allman).
    string(REGEX MATCHALL "\\{" opens "${code}")
    string(REGEX MATCHALL "\\}" closes "${code}")
    list(LENGTH opens open_count)
    list(LENGTH closes close_count)
    if(code MATCHES "^[ \t]*\\}")
      math(EXPR pops "${close_count}")
      foreach(i RANGE 1 ${pops})
        if(NOT stack STREQUAL "")
          string(SUBSTRING "${stack}" 1 -1 stack)
        endif()
      endforeach()
      set(close_count 0)
    endif()
    if(open_count GREATER close_count)
      math(EXPR pushes "${open_count}-${close_count}")
      if(code MATCHES "^[ \t]*\\{")
        set(kind_text "${prev_code}")
      else()
        set(kind_text "${code}")
      endif()
      if(kind_text MATCHES "(^|[^A-Za-z0-9_])(class|struct|union)[ \t]" AND NOT kind_text MATCHES "(^|[^A-Za-z0-9_])enum[ \t]" AND NOT kind_text MATCHES "\\(")
        set(kind T)
      else()
        set(kind O)
      endif()
      foreach(i RANGE 1 ${pushes})
        set(stack "${kind}${stack}")
      endforeach()
    elseif(close_count GREATER open_count)
      math(EXPR pops "${close_count}-${open_count}")
      foreach(i RANGE 1 ${pops})
        if(NOT stack STREQUAL "")
          string(SUBSTRING "${stack}" 1 -1 stack)
        endif()
      endforeach()
    endif()
    set(prev_code "${code}")
  endforeach()
endforeach()

foreach(entry IN LISTS allowed)
  list(FIND allowed_used "${entry}" at)
  if(at LESS 0)
    gate_problem("${ALLOWLIST}: stale entry ${entry}: it exempts nothing")
  endif()
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "shared_state_check: ${errors} violation(s)")
endif()
message(STATUS "shared_state_check: ok")
