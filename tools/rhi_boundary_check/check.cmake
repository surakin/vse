# RHI boundary gate (Phase 3 Day 66). Run as:
#   cmake -DROOT=<tree> -DALLOWLIST=<file> -P check.cmake
# Rule 1: no file under engine/, game/, tools/, tests/renderer/ outside engine/rhi/vulkan/ names a
#         Vulkan API identifier (vk*, Vk*, VK_*, PFN_vk*) or includes a vulkan header.
# Rule 2: backend-agnostic engine/rhi/*.h must not include Vulkan/Wayland/X11 headers.
# Exceptions live in the allow-list as `path|reason`; stale or reasonless entries fail.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT OR NOT ALLOWLIST)
  message(FATAL_ERROR "usage: -DROOT=<tree> -DALLOWLIST=<file>")
endif()

# Read a file as a list of lines, safe against ';', '[' and ']' inside the text.
function(read_lines path out)
  file(READ "${path}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" content "${content}")
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

get_filename_component(ROOT "${ROOT}" ABSOLUTE)
get_filename_component(ALLOWLIST "${ALLOWLIST}" ABSOLUTE)

set(errors 0)
set(allowed "")
read_lines("${ALLOWLIST}" allow_lines)
foreach(line IN LISTS allow_lines)
  string(STRIP "${line}" line)
  if(line STREQUAL "" OR line MATCHES "^#")
    continue()
  endif()
  string(FIND "${line}" "|" bar)
  if(bar LESS 1)
    message(SEND_ERROR "allow-list entry has no reason: ${line}")
    math(EXPR errors "${errors}+1")
    continue()
  endif()
  string(SUBSTRING "${line}" 0 ${bar} path)
  math(EXPR rest "${bar}+1")
  string(SUBSTRING "${line}" ${rest} -1 reason)
  string(STRIP "${path}" path)
  string(STRIP "${reason}" reason)
  if(reason STREQUAL "")
    message(SEND_ERROR "allow-list entry has an empty reason: ${line}")
    math(EXPR errors "${errors}+1")
    continue()
  endif()
  if(NOT EXISTS "${ROOT}/${path}")
    message(SEND_ERROR "stale allow-list entry (file missing): ${path}")
    math(EXPR errors "${errors}+1")
    continue()
  endif()
  list(APPEND allowed "${path}")
endforeach()

set(ident_re "(^|[^A-Za-z0-9_])(vk[A-Z][A-Za-z0-9_]*|Vk[A-Z][A-Za-z0-9_]*|VK_[A-Z0-9_]+|PFN_vk[A-Za-z0-9_]*)")
set(inc_vk_re "^[ \t]*#[ \t]*include[ \t]*[<\"][^>\"]*[Vv]ulkan[^>\"]*[>\"]")
set(inc_back_re "^[ \t]*#[ \t]*include[ \t]*[<\"][^>\"]*(wayland|[Xx]11|xcb|rhi/(null|dx12|metal)/)[^>\"]*[>\"]")

set(files "")
foreach(dir engine game tools tests/renderer)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp"
       "${ROOT}/${dir}/*.cpp" "${ROOT}/${dir}/*.cc" "${ROOT}/${dir}/*.c" "${ROOT}/${dir}/*.inl" "${ROOT}/${dir}/*.mm")
  list(APPEND files ${found})
endforeach()

set(used_allow "")
foreach(f IN LISTS files)
  if(f MATCHES "^engine/rhi/vulkan/" OR f MATCHES "^tools/rhi_boundary_check/")
    continue()
  endif()
  read_lines("${ROOT}/${f}" lines)
  set(hits "")
  set(n 0)
  set(in_block FALSE)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    set(raw "${l}")
    # Reduce the line to code: drop block comments (which may span lines) and // comments. Names inside string
    # literals are kept on purpose -- dlsym("vkFoo") is Vulkan API use too.
    set(code "")
    set(rest "${l}")
    while(NOT rest STREQUAL "")
      if(in_block)
        string(FIND "${rest}" "*/" close)
        if(close EQUAL -1)
          set(rest "")
        else()
          math(EXPR from "${close}+2")
          string(SUBSTRING "${rest}" ${from} -1 rest)
          set(in_block FALSE)
        endif()
      else()
        string(FIND "${rest}" "/*" open)
        string(FIND "${rest}" "//" line_comment)
        if(NOT line_comment EQUAL -1 AND (open EQUAL -1 OR line_comment LESS open))
          string(SUBSTRING "${rest}" 0 ${line_comment} head)
          string(APPEND code "${head}")
          set(rest "")
        elseif(open EQUAL -1)
          string(APPEND code "${rest}")
          set(rest "")
        else()
          string(SUBSTRING "${rest}" 0 ${open} head)
          string(APPEND code "${head} ")
          math(EXPR from "${open}+2")
          string(SUBSTRING "${rest}" ${from} -1 rest)
          set(in_block TRUE)
        endif()
      endif()
    endwhile()
    if(code MATCHES "${inc_vk_re}" OR code MATCHES "${ident_re}")
      list(APPEND hits "${f}:${n}: ${raw}")
    endif()
  endforeach()
  # Reverse rule: agnostic RHI headers.
  if(f MATCHES "^engine/rhi/[^/]+\\.h$")
    set(n 0)
    foreach(l IN LISTS lines)
      math(EXPR n "${n}+1")
      if(l MATCHES "${inc_back_re}")
        list(APPEND hits "${f}:${n}: backend include in agnostic header: ${l}")
      endif()
    endforeach()
  endif()
  if(hits)
    list(FIND allowed "${f}" idx)
    if(idx GREATER -1)
      list(APPEND used_allow "${f}")
    else()
      foreach(h IN LISTS hits)
        string(REPLACE "<SEMI>" ";" h "${h}")
        string(REPLACE "<LB>" "[" h "${h}")
        string(REPLACE "<RB>" "]" h "${h}")
        message(SEND_ERROR "boundary violation: ${h}")
        math(EXPR errors "${errors}+1")
      endforeach()
    endif()
  endif()
endforeach()

foreach(a IN LISTS allowed)
  list(FIND used_allow "${a}" idx)
  if(idx EQUAL -1)
    message(SEND_ERROR "stale allow-list entry (no Vulkan use left): ${a}")
    math(EXPR errors "${errors}+1")
  endif()
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "rhi_boundary_check: ${errors} problem(s)")
endif()
message(STATUS "rhi_boundary_check: clean (${errors} problems)")
