# Shared-representation gate (Phase 22, the user's rule of 2026-11-14). Run as:
#   cmake -DROOT=<tree> [-DUNITS=<units.txt>] [-DALLOWLIST=<allowlist.txt>] -P check.cmake
# Classes that need the same data share a `SharedPtr` to a small class that holds it; they never keep a raw pointer or reference into
# one another's storage. The shared units are listed in units.txt. Rules, over every .h/.cpp/.mm under engine/, game/, tools/ and tests/
# (the planted fixtures of tools/*/fixtures excepted):
#   1. A data member of a class or struct is not a raw pointer or reference to a shared unit (`const GpuMesh* mesh;`, `GpuMesh& mesh;`,
#      `Vector<const GpuMesh*> meshes;`), and, in the blob and renderer code (engine/asset, engine/renderer, tools/asset_mint, their tests),
#      is not a `ByteSpan` (a view into bytes another class owns: hold a `SharedBytesPtr` and offsets).
#   2. A `SharedPtr` to a shared unit is spelled with its alias (`GpuMeshPtr`, `GpuMeshConstPtr`), not `SharedPtr<GpuMesh>`.
#   3. The header named for a unit defines its aliases.
# The files that break rule 1 today are in allowlist.txt (path|reason; each is a debt the shared-ownership refactor removes); an entry that
# no longer exempts anything fails the gate. Comments and strings are ignored.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree>")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
get_filename_component(SELF_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
if(NOT UNITS)
  set(UNITS "${SELF_DIR}/units.txt")
endif()
if(NOT ALLOWLIST)
  set(ALLOWLIST "${SELF_DIR}/allowlist.txt")
endif()

set(errors 0)
function(gate_problem text)
  message(NOTICE "error: ${text}")
  math(EXPR count "${errors}+1")
  set(errors ${count} PARENT_SCOPE)
endfunction()

function(read_lines path out)
  file(READ "${path}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" content "${content}")
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

# The units.
set(unit_names "")
set(unit_aliases "")
set(unit_const_aliases "")
set(unit_headers "")
file(STRINGS "${UNITS}" unit_lines)
foreach(line IN LISTS unit_lines)
  if(line MATCHES "^[ \t]*#" OR line MATCHES "^[ \t]*$")
    continue()
  endif()
  string(REPLACE "|" ";" parts "${line}")
  # An empty field would vanish from a CMake list: put the line back together by position.
  string(REGEX MATCH "^([^|]*)\\|([^|]*)\\|([^|]*)\\|(.*)$" ignore "${line}")
  set(alias "${CMAKE_MATCH_2}")
  set(const_alias "${CMAKE_MATCH_3}")
  if(alias STREQUAL "")
    set(alias "-")  # an empty element would vanish from the list
  endif()
  if(const_alias STREQUAL "")
    set(const_alias "-")
  endif()
  list(APPEND unit_names "${CMAKE_MATCH_1}")
  list(APPEND unit_aliases "${alias}")
  list(APPEND unit_const_aliases "${const_alias}")
  list(APPEND unit_headers "${CMAKE_MATCH_4}")
endforeach()
string(REPLACE ";" "|" unit_alt "${unit_names}")

# The allow list.
set(allowed "")
set(allowed_used "")
if(EXISTS "${ALLOWLIST}")
  file(STRINGS "${ALLOWLIST}" allow_lines)
  foreach(line IN LISTS allow_lines)
    if(line MATCHES "^[ \t]*#" OR line MATCHES "^[ \t]*$")
      continue()
    endif()
    if(NOT line MATCHES "^([^|]+)\\|(.+)$")
      gate_problem("${ALLOWLIST}: an entry needs `path|reason`: ${line}")
      continue()
    endif()
    list(APPEND allowed "${CMAKE_MATCH_1}")
  endforeach()
endif()

# Rule 3: the aliases exist.
list(LENGTH unit_names unit_count)
if(unit_count GREATER 0)
  math(EXPR last "${unit_count}-1")
  foreach(i RANGE ${last})
    list(GET unit_names ${i} name)
    list(GET unit_aliases ${i} alias)
    list(GET unit_const_aliases ${i} const_alias)
    list(GET unit_headers ${i} header)
    if(NOT EXISTS "${ROOT}/${header}")
      gate_problem("${UNITS}: the header ${header} of ${name} does not exist")
      continue()
    endif()
    file(READ "${ROOT}/${header}" header_text)
    if(NOT alias STREQUAL "-" AND NOT header_text MATCHES "using[ \t]+${alias}[ \t]*=[ \t]*SharedPtr<${name}>;")
      gate_problem("${header}: defines no `using ${alias} = SharedPtr<${name}>;`")
    endif()
    if(NOT const_alias STREQUAL "-" AND NOT header_text MATCHES "using[ \t]+${const_alias}[ \t]*=[ \t]*SharedPtr<const ${name}>;")
      gate_problem("${header}: defines no `using ${const_alias} = SharedPtr<const ${name}>;`")
    endif()
  endforeach()
endif()

set(files "")
foreach(dir engine game tools tests)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp" "${ROOT}/${dir}/*.cpp" "${ROOT}/${dir}/*.mm")
  list(APPEND files ${found})
endforeach()

# Rule 1's shapes, with a unit name in them.
set(qualifier "([A-Za-z_][A-Za-z0-9_]*::)*")
set(member_re "^[ \t]*((mutable|static|const|constexpr)[ \t]+)*${qualifier}(${unit_alt})[ \t]*(\\*|&)[ \t]*(const[ \t]+)?[A-Za-z_][A-Za-z0-9_]*[ \t]*(<LB>.*<RB>)?[ \t]*(=.*)?<SEMI>[ \t]*$")
set(container_re "^[ \t]*((mutable|static)[ \t]+)?(Vector|Array|Span|HashMap)<.*${qualifier}(${unit_alt})[ \t]*\\*.*>[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*(=.*)?<SEMI>[ \t]*$")
set(bytes_re "^[ \t]*((mutable|static|const)[ \t]+)*ByteSpan[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*(=.*)?<SEMI>[ \t]*$")
# Rule 2's shape.
set(spelled_re "SharedPtr<[ \t]*(const[ \t]+)?${qualifier}(${unit_alt})[ \t]*>")

foreach(f IN LISTS files)
  if(f MATCHES "^tools/[^/]+/fixtures/" AND NOT ROOT MATCHES "/fixtures/")
    continue()
  endif()
  read_lines("${ROOT}/${f}" lines)
  set(n 0)
  set(in_block FALSE)
  set(pending_type FALSE)
  set(stack "")  # one of `T` (a class or struct body) or `O` (anything else) per open brace
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    set(code "${l}")
    string(REGEX REPLACE "\"([^\"\\\\]|\\\\.)*\"" "\"\"" code "${code}")
    if(in_block)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        continue()
      endif()
      math(EXPR after "${close}+2")
      string(SUBSTRING "${code}" ${after} -1 code)
      set(in_block FALSE)
    endif()
    string(REGEX REPLACE "/\\*[^*]*\\*+([^/*][^*]*\\*+)*/" " " code "${code}")
    string(FIND "${code}" "//" slashes)
    if(NOT slashes LESS 0)
      string(SUBSTRING "${code}" 0 ${slashes} code)
    endif()
    string(FIND "${code}" "/*" open)
    if(NOT open LESS 0)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        string(SUBSTRING "${code}" 0 ${open} code)
        set(in_block TRUE)
      endif()
    endif()

    # Where the line starts: inside a class or struct body?
    set(in_type FALSE)
    if(NOT stack STREQUAL "")
      string(SUBSTRING "${stack}" 0 1 top)
      if(top STREQUAL "T")
        set(in_type TRUE)
      endif()
    endif()

    # Rule 2.
    if(code MATCHES "${spelled_re}")
      set(skip FALSE)
      if(code MATCHES "using[ \t]+[A-Za-z0-9_]+[ \t]*=")
        set(skip TRUE)
      endif()
      if(NOT skip)
        string(REPLACE "<LB>" "[" shown "${l}")
        string(REPLACE "<RB>" "]" shown "${shown}")
        string(REPLACE "<SEMI>" ";" shown "${shown}")
        string(STRIP "${shown}" shown)
        gate_problem("${f}:${n}: spell a SharedPtr to a shared unit with its alias (GpuMeshPtr, SharedBytesPtr, ...; units.txt): ${shown}")
      endif()
    endif()

    # Rule 1.
    set(is_member FALSE)
    if(in_type AND NOT code MATCHES "operator")
      if(code MATCHES "${member_re}" OR code MATCHES "${container_re}")
        set(is_member TRUE)
      elseif(code MATCHES "${bytes_re}" AND f MATCHES "^(engine/(asset|renderer)|tools/asset_mint|tests/(asset|renderer))/")
        set(is_member TRUE)
      endif()
    endif()
    if(is_member)
      list(FIND allowed "${f}" at)
      if(at LESS 0)
        string(REPLACE "<LB>" "[" shown "${l}")
        string(REPLACE "<RB>" "]" shown "${shown}")
        string(REPLACE "<SEMI>" ";" shown "${shown}")
        string(STRIP "${shown}" shown)
        gate_problem("${f}:${n}: a member must not point into another class's storage; hold a SharedPtr alias to the shared unit (or SharedBytesPtr and offsets): ${shown}")
      else()
        list(APPEND allowed_used "${f}")
      endif()
    endif()

    # Brace bookkeeping: a class or struct head (not an enum, a forward declaration, a friend or a template parameter) marks the next `{`.
    set(head "${code}")
    string(REGEX REPLACE "template[ \t]*<[^>]*>" " " head "${head}")
    if(head MATCHES "(^|[^A-Za-z0-9_])(class|struct)[ \t]+[A-Za-z_]" AND NOT head MATCHES "enum[ \t]+(class|struct)" AND
       NOT head MATCHES "friend[ \t]" AND NOT head MATCHES "<SEMI>[ \t]*$")
      set(pending_type TRUE)
    endif()
    string(REGEX MATCHALL "[{}]" braces "${code}")
    foreach(b IN LISTS braces)
      if(b STREQUAL "{")
        if(pending_type)
          set(stack "T${stack}")
          set(pending_type FALSE)
        else()
          set(stack "O${stack}")
        endif()
      else()
        string(LENGTH "${stack}" depth)
        if(depth GREATER 0)
          string(SUBSTRING "${stack}" 1 -1 stack)
        endif()
      endif()
    endforeach()
    if(code MATCHES "<SEMI>[ \t]*$")
      set(pending_type FALSE)
    endif()
  endforeach()
endforeach()

# A stale allow-list entry fails.
foreach(entry IN LISTS allowed)
  list(FIND allowed_used "${entry}" at)
  if(at LESS 0)
    gate_problem("${ALLOWLIST}: stale entry ${entry} (it exempts nothing; remove it)")
  endif()
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "shared_unit_check: ${errors} violation(s)")
endif()
list(LENGTH files total)
message(STATUS "shared_unit_check: ${total} files clean")
