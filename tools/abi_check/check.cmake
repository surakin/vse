# ABI gate for the shared engine library (Phase 23 Day 344). Run as:
#   cmake -DEXPORTS=<abi/engine.exports> -DVERSION_HEADER=<engine_abi_version.h>
#         [-DLIBRARY=<libengine.so> -DNM=<nm> | -DNM_OUTPUT=<file of `nm -D --defined-only` text>] [-DNM_STYLE=macho: `nm -gU` of a dylib]
#         [-DPREVIOUS=<the last list> | -DGIT_ROOT=<repo>]  [-DC_HEADER=<engine_c.h> -DC_COMPILER=<cc>]  -P check.cmake
# Checks, each failing with a message that names the fix:
#   1. The version line of the export list and ENGINE_ABI_VERSION_MAJOR/MINOR of the version header are the same.
#   2. (with a library) The library's exported symbols are exactly the list: no symbol outside it, none missing.
#   3. (with the last list: PREVIOUS, or `git show HEAD:abi/engine.exports` of GIT_ROOT) A removed symbol needs a higher major version, an added symbol
#      a higher minor (or major) version, and the version never goes down: a change of the ABI is a decision, not an accident.
#   4. (with the C header) The header is valid C11 (`-std=c11 -pedantic -Wall -Wextra -Werror -fsyntax-only`) and holds no C++ token (class, namespace, template,
#      `::`, std, nullptr, true, false, `extern "C"` outside a `#ifdef __cplusplus` block) in its code (comments and strings are not code).
cmake_minimum_required(VERSION 3.20)

set(errors 0)
function(gate_problem text)
  message(NOTICE "error: ${text}")
  math(EXPR count "${errors}+1")
  set(errors ${count} PARENT_SCOPE)
endfunction()

# Reads a list from its text: sets <prefix>_MAJOR, <prefix>_MINOR (empty when there is no version line) and <prefix>_SYMBOLS. A macro, so that gate_problem
# reaches the script's error count; the text is split on newlines after `;` and brackets are protected (a comment may hold them).
macro(read_exports_text text origin prefix)
  set(_t "${text}")
  string(REPLACE ";" "<SEMI>" _t "${_t}")
  string(REPLACE "[" "<LB>" _t "${_t}")
  string(REPLACE "]" "<RB>" _t "${_t}")
  string(REPLACE "\n" ";" _lines "${_t}")
  set(_symbols "")
  set(_major "")
  set(_minor "")
  set(_unreleased FALSE)
  foreach(_line IN LISTS _lines)
    string(STRIP "${_line}" _line)
    if(_line STREQUAL "" OR _line MATCHES "^#")
      continue()
    elseif(_line MATCHES "^version ([0-9]+)\\.([0-9]+)$")
      set(_major ${CMAKE_MATCH_1})
      set(_minor ${CMAKE_MATCH_2})
    elseif(_line STREQUAL "status unreleased")
      set(_unreleased TRUE)
    elseif(_line MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
      list(APPEND _symbols ${_line})
    else()
      gate_problem("${origin}: not a version line or a symbol name: ${_line}")
    endif()
  endforeach()
  set(${prefix}_MAJOR "${_major}")
  set(${prefix}_MINOR "${_minor}")
  set(${prefix}_SYMBOLS "${_symbols}")
  set(${prefix}_UNRELEASED ${_unreleased})
endmacro()

if(NOT EXPORTS OR NOT VERSION_HEADER)
  message(FATAL_ERROR "usage: -DEXPORTS=<file> -DVERSION_HEADER=<file> [...] -P check.cmake")
endif()
file(READ "${EXPORTS}" exports_text)
read_exports_text("${exports_text}" "${EXPORTS}" now)
if(now_MAJOR STREQUAL "")
  gate_problem("${EXPORTS}: no `version MAJOR.MINOR` line")
endif()
list(LENGTH now_SYMBOLS now_count)
set(sorted ${now_SYMBOLS})
list(SORT sorted)
list(REMOVE_DUPLICATES sorted)
list(LENGTH sorted unique_count)
if(NOT now_count EQUAL unique_count)
  gate_problem("${EXPORTS}: a symbol is listed twice")
endif()

# 1. The version header.
file(READ "${VERSION_HEADER}" header_text)
if(header_text MATCHES "#define ENGINE_ABI_VERSION_MAJOR ([0-9]+)")
  set(header_major ${CMAKE_MATCH_1})
else()
  set(header_major "")
endif()
if(header_text MATCHES "#define ENGINE_ABI_VERSION_MINOR ([0-9]+)")
  set(header_minor ${CMAKE_MATCH_1})
else()
  set(header_minor "")
endif()
if(NOT "${header_major}.${header_minor}" STREQUAL "${now_MAJOR}.${now_MINOR}")
  gate_problem("${VERSION_HEADER} says ${header_major}.${header_minor} but ${EXPORTS} says ${now_MAJOR}.${now_MINOR}: bump both together")
endif()

# 2. The library.
set(have_library FALSE)
# NM_STYLE=macho (macOS, Day 355): the dylib's exports are its defined external symbols (`nm -gU`), each with the C prefix `_`; there are no version nodes.
if(LIBRARY AND NM AND NM_STYLE STREQUAL "macho")
  execute_process(COMMAND "${NM}" -gU "${LIBRARY}" RESULT_VARIABLE nm_rc OUTPUT_VARIABLE nm_text ERROR_VARIABLE nm_err)
  if(NOT nm_rc EQUAL 0)
    gate_problem("${NM} -gU failed on ${LIBRARY}: ${nm_err}")
  else()
    set(have_library TRUE)
  endif()
elseif(LIBRARY AND NM)
  execute_process(COMMAND "${NM}" -D --defined-only "${LIBRARY}" RESULT_VARIABLE nm_rc OUTPUT_VARIABLE nm_text ERROR_VARIABLE nm_err)
  if(NOT nm_rc EQUAL 0)
    gate_problem("${NM} -D failed on ${LIBRARY}: ${nm_err}")
  else()
    set(have_library TRUE)
  endif()
elseif(NM_OUTPUT)
  file(READ "${NM_OUTPUT}" nm_text)
  set(have_library TRUE)
endif()
if(have_library)
  string(REPLACE "\n" ";" nm_lines "${nm_text}")
  set(exported "")
  foreach(line IN LISTS nm_lines)
    string(STRIP "${line}" line)
    # "<address> <type> <name>[@@VERSION]": absolute symbols (type A) are the version nodes themselves, not exports.
    if(line MATCHES "^[0-9a-fA-F]+ ([A-Za-z]) ([^ ]+)$")
      set(type ${CMAKE_MATCH_1})
      set(name ${CMAKE_MATCH_2})
      if(type STREQUAL "A" OR name MATCHES "^(_init|_fini|_edata|_end|__bss_start)$")
        continue()  # version nodes (absolute) and the linker's own boundary symbols are not exports
      endif()
      string(REGEX REPLACE "@.*$" "" name "${name}")
      if(NM_STYLE STREQUAL "macho")
        if(NOT name MATCHES "^_")
          gate_problem("the library exports ${name}, which has no C symbol prefix `_`: not a C function")
          continue()
        endif()
        string(SUBSTRING "${name}" 1 -1 name)
      endif()
      list(APPEND exported ${name})
    endif()
  endforeach()
  foreach(name IN LISTS exported)
    if(NOT name IN_LIST now_SYMBOLS)
      gate_problem("the library exports ${name}, which abi/engine.exports does not list: mark nothing but the C API with ENGINE_API, or add the line and bump the version")
    endif()
  endforeach()
  foreach(name IN LISTS now_SYMBOLS)
    if(NOT name IN_LIST exported)
      gate_problem("abi/engine.exports lists ${name}, which the library does not export")
    endif()
  endforeach()
endif()

# 3. The last list (not before the first release: `status unreleased`).
set(have_previous FALSE)
if(PREVIOUS)
  file(READ "${PREVIOUS}" previous_text)
  set(have_previous TRUE)
elseif(GIT_ROOT)
  execute_process(COMMAND git -C "${GIT_ROOT}" show HEAD:abi/engine.exports RESULT_VARIABLE git_rc OUTPUT_VARIABLE previous_text ERROR_QUIET)
  if(git_rc EQUAL 0)
    set(have_previous TRUE)
  else()
    message(STATUS "abi_check: no last list in git (not a checkout, or the list is new): the version-bump rule was not checked")
  endif()
endif()
if(have_previous AND now_UNRELEASED)
  # Before the first release nothing is installed anywhere, so the list may change freely (the line `status unreleased` of abi/engine.exports; the first
  # release removes it, and from then on the rules below hold).
  message(STATUS "abi_check: the list is marked `status unreleased`: the version-bump rule was not checked")
  set(have_previous FALSE)
endif()
if(have_previous)
  read_exports_text("${previous_text}" "the last list" before)
  set(removed "")
  set(added "")
  foreach(name IN LISTS before_SYMBOLS)
    if(NOT name IN_LIST now_SYMBOLS)
      list(APPEND removed ${name})
    endif()
  endforeach()
  foreach(name IN LISTS now_SYMBOLS)
    if(NOT name IN_LIST before_SYMBOLS)
      list(APPEND added ${name})
    endif()
  endforeach()
  if(now_MAJOR LESS before_MAJOR OR (now_MAJOR EQUAL before_MAJOR AND now_MINOR LESS before_MINOR))
    gate_problem("the ABI version went down: ${before_MAJOR}.${before_MINOR} to ${now_MAJOR}.${now_MINOR}")
  endif()
  if(removed AND NOT now_MAJOR GREATER before_MAJOR)
    gate_problem("exports removed (${removed}) without a major version bump (still ${now_MAJOR}.${now_MINOR}): removing breaks hosts")
  endif()
  if(added AND NOT (now_MAJOR GREATER before_MAJOR OR now_MINOR GREATER before_MINOR))
    gate_problem("exports added (${added}) without a minor version bump (still ${now_MAJOR}.${now_MINOR}): bump the version in abi/engine.exports and engine_abi_version.h")
  endif()
endif()

# 4. The C header. It is force-included into an empty file, as a host would include it: compiled as the main file, a `static inline` helper that nothing
# calls would be a -Wunused-function error, which no includer sees.
if(C_HEADER)
  if(C_COMPILER)
    execute_process(COMMAND "${C_COMPILER}" -std=c11 -pedantic -Wall -Wextra -Werror -fsyntax-only -x c /dev/null -include "${C_HEADER}" RESULT_VARIABLE cc_rc ERROR_VARIABLE cc_err)
    if(NOT cc_rc EQUAL 0)
      gate_problem("${C_HEADER} is not valid C11: ${cc_err}")
    endif()
  endif()
  file(READ "${C_HEADER}" text)
  string(REPLACE ";" "<SEMI>" text "${text}")
  string(REPLACE "[" "<LB>" text "${text}")
  string(REPLACE "]" "<RB>" text "${text}")
  string(REPLACE "\n" ";" lines "${text}")
  set(n 0)
  set(in_block FALSE)
  set(in_cplusplus 0)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    set(code "${l}")
    # A `#ifdef __cplusplus` (or `#if defined(__cplusplus)`) block is C++ only: skipped up to its `#else` (then C code again) or its matching `#endif`.
    # `#ifndef __cplusplus` and `#if !defined(__cplusplus)` guard C code and are scanned. Conditionals inside the skipped block are counted.
    if(NOT in_cplusplus AND code MATCHES "^[ \t]*#[ \t]*(ifdef[ \t]+__cplusplus|if[ \t]+defined[ \t]*\\(?[ \t]*__cplusplus)")
      set(in_cplusplus 1)
      continue()
    endif()
    if(in_cplusplus)
      if(code MATCHES "^[ \t]*#[ \t]*if")
        math(EXPR in_cplusplus "${in_cplusplus}+1")
      elseif(code MATCHES "^[ \t]*#[ \t]*endif")
        math(EXPR in_cplusplus "${in_cplusplus}-1")
      elseif(in_cplusplus EQUAL 1 AND code MATCHES "^[ \t]*#[ \t]*(else|elif)")
        set(in_cplusplus 0)
      endif()
      continue()
    endif()
    string(REGEX REPLACE "\"([^\"\\\\]|\\\\.)*\"" "\"\"" code "${code}")
    if(in_block)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        continue()
      endif()
      math(EXPR after "${close}+2")
      string(SUBSTRING "${code}" ${after} -1 code)
      set(in_block FALSE)
    endif()
    string(REGEX REPLACE "/\\*[^*]*\\*+([^/*][^*]*\\*+)*/" " " code "${code}")
    string(FIND "${code}" "//" slashes)
    if(NOT slashes LESS 0)
      string(SUBSTRING "${code}" 0 ${slashes} code)
    endif()
    string(FIND "${code}" "/*" open)
    if(NOT open LESS 0)
      string(SUBSTRING "${code}" 0 ${open} code)
      set(in_block TRUE)
    endif()
    if(code MATCHES "(^|[^A-Za-z0-9_])(class|namespace|template|nullptr|true|false|std|typename|operator|public|private|protected|virtual|constexpr)([^A-Za-z0-9_]|$)" OR code MATCHES "::")
      string(STRIP "${l}" shown)
      gate_problem("${C_HEADER}:${n}: a C++ token in the C header: ${shown}")
    endif()
  endforeach()
endif()

if(errors GREATER 0)
  message(FATAL_ERROR "abi_check: ${errors} problem(s)")
endif()
message(STATUS "abi_check: version ${now_MAJOR}.${now_MINOR}, ${now_count} export(s) ok")
