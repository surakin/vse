# Asset boundary gate (Phase 22 Day 339). Run as:
#   cmake -DROOT=<tree> [-DALLOWLIST=<file>] -P check.cmake
# The runtime never depends on the importer or the tools (PLAN.md assumptions #4 and #19, CLAUDE.md "glTF import is an in-memory library"):
#   1. A file under engine/ outside engine/asset_import/ may not include "asset_import/..." or a header of tools/, and no CMake file under engine/
#      outside engine/asset_import/ may link `asset_import` or `asset_mint`.
#   2. A file under game/ or tools/ (tools/asset_mint excepted) may include "asset_import/..." or link it only through an allow-list entry, which
#      gives the reason (a demo's import mode, a host program).
#   3. The decoders (png.h, zlib.h, stb_image.h, and the png, zlib and stb_jpeg targets) are reached only from engine/asset_import/image_decode.cpp,
#      its C helper png_guard.c (libpng's setjmp, which MSVC refuses in C++) and its CMake file, or an allow-list entry (FreeType's color bitmaps,
#      the 3D text project).
#   4. The Ogg Vorbis libraries' headers (ogg/ogg.h, vorbis/codec.h, vorbis/vorbisfile.h, vorbis/vorbisenc.h) are included only by
#      engine/audio/vorbis.cpp, and the `ogg` and `vorbis` targets are linked only by engine/audio/CMakeLists.txt (Phase 26 Day 434): the audio
#      module and, through its facade, asset_mint reach the codec; nothing else does.
# Comments are not violations. A stale allow-list entry fails the gate, so the list only shrinks.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree> [-DALLOWLIST=<file>]")
endif()

set(errors 0)
function(gate_problem text)
  message(NOTICE "error: ${text}")
  math(EXPR count "${errors}+1")
  set(errors ${count} PARENT_SCOPE)
endfunction()

get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT ALLOWLIST)
  set(ALLOWLIST "${ROOT}/tools/asset_boundary_check/allowlist.txt")
endif()

set(allow_paths "")
if(EXISTS "${ALLOWLIST}")
  file(STRINGS "${ALLOWLIST}" allow_lines)
  foreach(line IN LISTS allow_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(FIND "${line}" "|" bar)
    if(bar LESS 1)
      gate_problem("${ALLOWLIST}: an entry needs `path|reason`: ${line}")
      continue()
    endif()
    string(SUBSTRING "${line}" 0 ${bar} p)
    math(EXPR after "${bar}+1")
    string(SUBSTRING "${line}" ${after} -1 reason)
    string(STRIP "${reason}" reason)
    if(reason STREQUAL "")
      gate_problem("${ALLOWLIST}: the entry for ${p} has no reason")
    endif()
    list(APPEND allow_paths "${p}")
  endforeach()
endif()
set(allow_used "")

set(importer_include_re "^[ \t]*#[ \t]*(include|import)[ \t]*[<\"]asset_import/")
set(tools_include_re "^[ \t]*#[ \t]*(include|import)[ \t]*[<\"]tools/")
set(decoder_include_re "^[ \t]*#[ \t]*(include|import)[ \t]*[<\"]([^>\"]*/)?(png|pngconf|zlib|zconf|stb_image)\\.h[>\"]")
set(codec_include_re "^[ \t]*#[ \t]*(include|import)[ \t]*[<\"](ogg|vorbis)/[A-Za-z]+\\.h[>\"]")
set(codec_link_re "(^|[^A-Za-z0-9_])(ogg|vorbis)(_asan|_tsan|\\$\\{[A-Za-z_]+\\})?([^A-Za-z0-9_]|$)")
set(importer_link_re "(^|[^A-Za-z0-9_])(asset_import|asset_mint)([^A-Za-z0-9_]|$)")
set(decoder_link_re "(^|[^A-Za-z0-9_])(png|zlib|stb_jpeg)(_asan|_tsan)?([^A-Za-z0-9_]|$)")

set(files "")
foreach(dir engine game tools tests)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp" "${ROOT}/${dir}/*.cpp"
       "${ROOT}/${dir}/*.cc" "${ROOT}/${dir}/*.inl" "${ROOT}/${dir}/*.mm" "${ROOT}/${dir}/*.c" "${ROOT}/${dir}/CMakeLists.txt")
  list(APPEND files ${found})
endforeach()

set(scanned 0)
foreach(f IN LISTS files)
  if(f MATCHES "/fixtures/" OR f MATCHES "/generated/")
    continue() # data for the tools' own tests
  endif()
  math(EXPR scanned "${scanned}+1")
  set(entry -1)
  set(i 0)
  foreach(p IN LISTS allow_paths)
    if((p MATCHES "/$" AND f MATCHES "^${p}") OR f STREQUAL p)
      set(entry ${i})
    endif()
    math(EXPR i "${i}+1")
  endforeach()
  set(in_engine FALSE)
  if(f MATCHES "^engine/" AND NOT f MATCHES "^engine/asset_import/")
    set(in_engine TRUE)
  endif()
  set(in_importer FALSE)
  if(f MATCHES "^engine/asset_import/")
    set(in_importer TRUE)
  endif()
  set(in_game_or_tools FALSE)
  if(f MATCHES "^game/" OR (f MATCHES "^tools/" AND NOT f MATCHES "^tools/asset_mint/"))
    set(in_game_or_tools TRUE)
  endif()
  set(decoder_home FALSE)
  if(f STREQUAL "engine/asset_import/image_decode.cpp" OR f STREQUAL "engine/asset_import/png_guard.c"
     OR f STREQUAL "engine/asset_import/CMakeLists.txt")
    set(decoder_home TRUE)
  endif()
  set(codec_home FALSE)
  if(f STREQUAL "engine/audio/vorbis.cpp" OR f STREQUAL "engine/audio/CMakeLists.txt")
    set(codec_home TRUE)
  endif()
  set(is_cmake FALSE)
  if(f MATCHES "CMakeLists\\.txt$")
    set(is_cmake TRUE)
  endif()
  file(READ "${ROOT}/${f}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" lines "${content}")
  set(n 0)
  set(in_link FALSE)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    set(why "")
    if(is_cmake)
      set(code "${l}")
      string(FIND "${code}" "#" hash)
      if(NOT hash LESS 0)
        string(SUBSTRING "${code}" 0 ${hash} code)
      endif()
      if(code MATCHES "target_link_libraries|link_libraries")
        set(in_link TRUE)
      endif()
      if(in_link)
        if(code MATCHES "${importer_link_re}" AND (in_engine OR in_game_or_tools))
          set(why "links the importer or the tool's library")
        endif()
        if(code MATCHES "${decoder_link_re}" AND NOT decoder_home AND NOT f MATCHES "^third_party/")
          set(why "links a decoder library")
        endif()
        if(code MATCHES "${codec_link_re}" AND NOT codec_home AND NOT f MATCHES "^third_party/")
          set(why "links the Ogg Vorbis libraries")
        endif()
      endif()
      if(code MATCHES "\\)")
        set(in_link FALSE)
      endif()
    else()
      if(l MATCHES "^[ \t]*//")
        continue()
      endif()
      if(l MATCHES "${importer_include_re}" AND (in_engine OR in_game_or_tools))
        set(why "includes the importer")
      endif()
      if(l MATCHES "${tools_include_re}" AND in_engine)
        set(why "includes a tool")
      endif()
      if(l MATCHES "${decoder_include_re}" AND NOT decoder_home)
        set(why "includes a decoder header")
      endif()
      if(l MATCHES "${codec_include_re}" AND NOT codec_home)
        set(why "includes an Ogg Vorbis header")
      endif()
    endif()
    if(why STREQUAL "")
      continue()
    endif()
    if(NOT entry EQUAL -1)
      list(APPEND allow_used ${entry})
      continue()
    endif()
    string(REPLACE "<LB>" "[" shown "${l}")
    string(REPLACE "<RB>" "]" shown "${shown}")
    string(REPLACE "<SEMI>" ";" shown "${shown}")
    string(STRIP "${shown}" shown)
    gate_problem("${f}:${n}: ${why}; the runtime and the demos reach glTF import and the image decoders only as tools/asset_boundary_check/check.cmake says (or add the file to tools/asset_boundary_check/allowlist.txt with a reason): ${shown}")
  endforeach()
endforeach()

set(i 0)
foreach(p IN LISTS allow_paths)
  list(FIND allow_used ${i} found_at)
  if(found_at LESS 0)
    gate_problem("${ALLOWLIST}: stale entry ${p}: nothing in it crosses the boundary any more; remove it")
  endif()
  math(EXPR i "${i}+1")
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "asset_boundary_check: ${errors} problem(s)")
endif()
message(STATUS "asset_boundary_check: ${scanned} files clean")
