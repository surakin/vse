# SQLite boundary gate (Phase 19 Day 251). Run as:
#   cmake -DROOT=<tree> [-DALLOWLIST=<file>] -P check.cmake
# Only the files under engine/database/sqlite/ may include sqlite3.h or name SQLite: an `sqlite3_` function, an `sqlite3` type, a `SQLITE_`
# macro. Everything else reaches SQLite through the database interface. A CMake file outside engine/database/ and third_party/ may not link the
# `sqlite3` target either. Exempt: comments, string literals and the files in the allow list, each with a reason. A stale allow-list entry
# (it no longer exempts anything) fails the gate, so the list only shrinks.
cmake_minimum_required(VERSION 3.20)

if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree> [-DALLOWLIST=<file>]")
endif()

set(errors 0)
function(gate_problem text)
  message(NOTICE "error: ${text}")
  math(EXPR count "${errors}+1")
  set(errors ${count} PARENT_SCOPE)
endfunction()

get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT ALLOWLIST)
  set(ALLOWLIST "${ROOT}/tools/sqlite_boundary_check/allowlist.txt")
endif()

set(allow_paths "")
if(EXISTS "${ALLOWLIST}")
  file(STRINGS "${ALLOWLIST}" allow_lines)
  foreach(line IN LISTS allow_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(FIND "${line}" "|" bar)
    if(bar LESS 1)
      gate_problem("${ALLOWLIST}: an entry needs `path|reason`: ${line}")
      continue()
    endif()
    string(SUBSTRING "${line}" 0 ${bar} p)
    math(EXPR after "${bar}+1")
    string(SUBSTRING "${line}" ${after} -1 reason)
    string(STRIP "${reason}" reason)
    if(reason STREQUAL "")
      gate_problem("${ALLOWLIST}: the entry for ${p} has no reason")
    endif()
    list(APPEND allow_paths "${p}")
  endforeach()
endif()
set(allow_used "")

set(name_re "(^|[^A-Za-z0-9_])(sqlite3[A-Za-z0-9_]*|SQLITE_[A-Z0-9_]+)([^A-Za-z0-9_]|$)")
set(include_re "^[ \t]*#[ \t]*(include|import)[ \t]*[<\"]([^>\"]*/)?sqlite3[A-Za-z0-9_]*\\.h[>\"]")
set(link_re "(^|[^A-Za-z0-9_])sqlite3([^A-Za-z0-9_]|$)")

set(files "")
foreach(dir engine game tools tests)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp" "${ROOT}/${dir}/*.cpp"
       "${ROOT}/${dir}/*.cc" "${ROOT}/${dir}/*.inl" "${ROOT}/${dir}/*.mm" "${ROOT}/${dir}/*.c" "${ROOT}/${dir}/CMakeLists.txt")
  list(APPEND files ${found})
endforeach()

set(scanned 0)
foreach(f IN LISTS files)
  if(f MATCHES "/fixtures/" OR f MATCHES "/generated/")
    continue() # data for the tools' own tests
  endif()
  if(f MATCHES "^engine/database/sqlite/")
    continue() # the one place SQLite is named
  endif()
  math(EXPR scanned "${scanned}+1")
  set(entry -1)
  set(i 0)
  foreach(p IN LISTS allow_paths)
    if((p MATCHES "/$" AND f MATCHES "^${p}") OR f STREQUAL p)
      set(entry ${i})
    endif()
    math(EXPR i "${i}+1")
  endforeach()
  set(is_cmake FALSE)
  if(f MATCHES "CMakeLists\\.txt$")
    set(is_cmake TRUE)
    if(f MATCHES "^engine/database/")
      continue() # the database module links sqlite3 for its SQLite library
    endif()
  endif()
  file(READ "${ROOT}/${f}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" lines "${content}")
  set(n 0)
  set(in_block FALSE)
  set(in_link FALSE)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    set(code "${l}")
    if(is_cmake)
      string(FIND "${code}" "#" hash)
      if(NOT hash LESS 0)
        string(SUBSTRING "${code}" 0 ${hash} code)
      endif()
      set(hit FALSE)
      if(code MATCHES "target_link_libraries|link_libraries")
        set(in_link TRUE) # a link statement may span lines: look at each until its closing parenthesis
      endif()
      if(in_link AND code MATCHES "${link_re}")
        set(hit TRUE)
      endif()
      if(in_link AND code MATCHES "\\)")
        set(in_link FALSE)
      endif()
    else()
      set(had_include FALSE)
      if(l MATCHES "${include_re}")
        set(had_include TRUE)
      endif()
      string(REGEX REPLACE "\"([^\"\\\\]|\\\\.)*\"" "\"\"" code "${code}")
      if(in_block)
        string(FIND "${code}" "*/" close)
        if(close LESS 0)
          continue()
        endif()
        math(EXPR after "${close}+2")
        string(SUBSTRING "${code}" ${after} -1 code)
        set(in_block FALSE)
      endif()
      string(REGEX REPLACE "/\\*[^*]*\\*+([^/*][^*]*\\*+)*/" " " code "${code}")
      string(FIND "${code}" "//" slashes)
      if(NOT slashes LESS 0)
        string(SUBSTRING "${code}" 0 ${slashes} code)
      endif()
      string(FIND "${code}" "/*" open)
      if(NOT open LESS 0)
        string(FIND "${code}" "*/" close)
        if(close LESS 0)
          string(SUBSTRING "${code}" 0 ${open} code)
          set(in_block TRUE)
        endif()
      endif()
      set(hit FALSE)
      if(had_include OR code MATCHES "${name_re}")
        set(hit TRUE)
      endif()
    endif()
    if(NOT hit)
      continue()
    endif()
    if(NOT entry EQUAL -1)
      list(APPEND allow_used ${entry})
      continue()
    endif()
    string(REPLACE "<LB>" "[" shown "${l}")
    string(REPLACE "<RB>" "]" shown "${shown}")
    string(REPLACE "<SEMI>" ";" shown "${shown}")
    string(STRIP "${shown}" shown)
    gate_problem("${f}:${n}: SQLite named outside engine/database/sqlite/; use the database interface (or add the file to tools/sqlite_boundary_check/allowlist.txt with a reason): ${shown}")
  endforeach()
endforeach()

set(i 0)
foreach(p IN LISTS allow_paths)
  list(FIND allow_used ${i} found_at)
  if(found_at LESS 0)
    gate_problem("${ALLOWLIST}: stale entry ${p}: nothing in it names SQLite any more; remove it")
  endif()
  math(EXPR i "${i}+1")
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "sqlite_boundary_check: ${errors} problem(s)")
endif()
message(STATUS "sqlite_boundary_check: ${scanned} files clean")
