# Tool tests of asset_mint (Phase 22 Day 333): run the tool over a copy of tests/asset/mint_sample and check exit codes and
# messages. -DTOOL=... -DSAMPLE=... -DWORK=... -DMODE=mint|verify|incremental|bad_source
file(REMOVE_RECURSE "${WORK}")
file(COPY "${SAMPLE}/" DESTINATION "${WORK}")
set(PROJECT "${WORK}/assets.project")

function(run expect_rc out_var)
  execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL expect_rc)
    message(FATAL_ERROR "asset_mint ${ARGN}: exit code ${rc}, expected ${expect_rc}\n${out}\n${err}")
  endif()
  set(${out_var} "${out}\n${err}" PARENT_SCOPE)
endfunction()

function(expect text output)
  string(FIND "${output}" "${text}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "expected '${text}' in:\n${output}")
  endif()
endfunction()

if(MODE STREQUAL "mint")
  run(0 out check "${PROJECT}")
  run(0 out mint "${PROJECT}")
  expect("7 sources: 7 minted, 0 unchanged, 7 blob files written, 0 failed" "${out}")
  run(0 out list "${PROJECT}")
  expect("/materials/brick" "${out}")
  expect("/levels/main" "${out}")
  run(0 out list "${PROJECT}" --skeletons)
  expect("2 joints" "${out}")
  expect("used by animation clips/idle.anim.blob" "${out}")
elseif(MODE STREQUAL "verify")
  run(0 out mint "${PROJECT}")
  run(0 out pack "${PROJECT}")
  run(0 out verify "${PROJECT}")
  expect("the output verifies" "${out}")
  if(NOT EXISTS "${WORK}/out/sample.pak")
    message(FATAL_ERROR "the pak was not written")
  endif()
elseif(MODE STREQUAL "incremental")
  run(0 out mint "${PROJECT}")
  run(0 out mint "${PROJECT}")
  expect("7 sources: 0 minted, 7 unchanged, 0 blob files written, 0 failed" "${out}")
  file(APPEND "${WORK}/src/materials/brick.mat.src" "# a comment\n")
  run(0 out mint "${PROJECT}")
  expect("1 minted, 6 unchanged, 0 blob files written" "${out}")
  run(0 out mint "${PROJECT}" --force)
  expect("7 minted, 0 unchanged, 0 blob files written" "${out}")
elseif(MODE STREQUAL "bad_source")
  file(WRITE "${WORK}/src/meshes/broken.mesh.src" "id 0000000000000bad\nbogus record\n")
  run(1 out mint "${PROJECT}")
  expect("meshes/broken.mesh.src:2" "${out}")
  expect("7 minted" "${out}")
  expect("1 failed" "${out}")
  file(WRITE "${WORK}/src/meshes/broken.mesh.src" "v 0 0 0\n")
  run(1 out mint "${PROJECT}")
  expect("asset_mint adopt" "${out}")
  run(0 out adopt "${PROJECT}")
  expect("adopted 1 sources" "${out}")
  run(0 out adopt "${PROJECT}")
  expect("adopted 0 sources" "${out}")
  # A project file that cannot be read stops there: no walk of a folder that was never named.
  run(1 out verify "${WORK}/nope.project")
  expect("the project file cannot be read" "${out}")
  string(FIND "${out}" "resources.table" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "verify went on after the project file failed:\n${out}")
  endif()
elseif(MODE STREQUAL "gltf")
  # Phase 22 Day 338: the import-gltf command over a textured, skinned and animated glTF (tests/asset/data/gltf/model.gltf).
  set(MODEL "${SAMPLE}/../data/gltf/model.gltf")
  run(0 out import-gltf "${MODEL}" "--out=${WORK}/imported" "--manifest=${WORK}/model.import")
  expect("imported 5 resources" "${out}")
  foreach(blob textures/gradient materials/painted skeletons/rig meshes/quad clips/sway_rig)
    if(NOT EXISTS "${WORK}/imported/gltf/${blob}.blob")
      message(FATAL_ERROR "the import wrote no ${blob}")
    endif()
  endforeach()
  file(READ "${WORK}/imported/gltf/meshes/quad.blob" first HEX)
  # A second import with the manifest of the first keeps every id: the blobs are byte-identical.
  run(0 out import-gltf "${MODEL}" "--out=${WORK}/again" "--manifest=${WORK}/model.import")
  file(READ "${WORK}/again/gltf/meshes/quad.blob" second HEX)
  if(NOT first STREQUAL second)
    message(FATAL_ERROR "the second import changed the mesh blob")
  endif()
  # The blobs pack into a pak that verifies.
  run(0 out pack "${WORK}/imported" "${WORK}/imported.pak")
  # Phase 24 Day 364: --emit-level adds the default scene as a level; with the manifest of the first import the level
  # is byte-identical.
  run(0 out import-gltf "${MODEL}" "--out=${WORK}/with_level" "--manifest=${WORK}/model_level.import" --emit-level)
  expect("imported 6 resources" "${out}")
  file(GLOB level_blobs "${WORK}/with_level/gltf/levels/*.blob")
  list(LENGTH level_blobs level_count)
  if(NOT level_count EQUAL 1)
    message(FATAL_ERROR "the import with --emit-level wrote ${level_count} levels")
  endif()
  file(READ "${level_blobs}" level_first HEX)
  run(0 out import-gltf "${MODEL}" "--out=${WORK}/with_level_again" "--manifest=${WORK}/model_level.import" --emit-level)
  file(GLOB level_again "${WORK}/with_level_again/gltf/levels/*.blob")
  file(READ "${level_again}" level_second HEX)
  if(NOT level_first STREQUAL level_second)
    message(FATAL_ERROR "the second import changed the level blob")
  endif()
  # A refusal exits 1 and names the glTF object.
  file(WRITE "${WORK}/bad.gltf" "{\"asset\":{\"version\":\"2.0\"},\"meshes\":[{\"primitives\":[{\"attributes\":{\"NORMAL\":0}}]}]}")
  run(1 out import-gltf "${WORK}/bad.gltf" "--out=${WORK}/bad_out")
  # A bad option value is a usage error.
  run(64 out import-gltf "${MODEL}" "--out=${WORK}/x" "--scale=abc")
elseif(MODE STREQUAL "edit")
  run(0 out mint "${PROJECT}")
  run(0 out refs "${PROJECT}" /textures/brick)
  expect("/materials/brick" "${out}")
  run(1 out delete "${PROJECT}" /textures/brick)
  expect("materials/brick.mat.src" "${out}")
  expect("nothing was removed" "${out}")
  if(NOT EXISTS "${WORK}/src/textures/brick.tex.src")
    message(FATAL_ERROR "a referenced asset was removed")
  endif()
  run(0 out rename "${PROJECT}" /textures/brick stone)
  run(0 out move "${PROJECT}" /meshes/rock props)
  run(0 out mint "${PROJECT}")
  run(0 out copy "${PROJECT}" /props/rock /props/rock2)
  run(0 out mint "${PROJECT}")
  expect("8 sources" "${out}")
  run(0 out unmint "${PROJECT}" /materials/brick)
  expect("texture albedo_tex /textures/stone" "${out}")
  run(1 out rename "${PROJECT}" /nothing/here x)
elseif(MODE STREQUAL "target")
  run(0 out mint "${PROJECT}")
  run(0 out pack "${PROJECT}")
  run(0 out pack "${PROJECT}" --target 1)
  if(NOT EXISTS "${WORK}/out/sample.t1.pak")
    message(FATAL_ERROR "the pak of target 1 was not written")
  endif()
  run(0 out verify "${PROJECT}" --target 1 --require-current)
  run(1 out pack "${PROJECT}" --target 9)
  expect("textures/brick" "${out}")
  run(0 out remint "${WORK}/out")
  expect("0 upgraded" "${out}")
  run(0 out remint "${PROJECT}")
  run(64 out verify "${PROJECT}" --force)  # an option the command does not take: the usage, exit code 64
else()
  message(FATAL_ERROR "unknown MODE '${MODE}'")
endif()
