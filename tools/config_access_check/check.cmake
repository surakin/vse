# Configuration access gate (Phase 11 Day 139). Run as: cmake -DROOT=<tree> [-DALLOWLIST=<file>] [-DDIRS="engine;game"] -P check.cmake
# Anything a user can configure is a setting registered with settings::Registry and read through Setting<T> or Settings: code under engine/ and game/ may
# not call `getenv` or parse a `--flag` of its own. A file may only do so if it is in the allow list with a reason (code that runs before any Settings can
# exist, such as the window host reading ENGINE_WINDOW_BACKEND, the death-test child protocol, and a demo's launch-only options). Comments are ignored. A
# stale allow-list entry (it no longer exempts anything) fails the gate, so the list only shrinks.
cmake_minimum_required(VERSION 3.20)
if(NOT ROOT)
  message(FATAL_ERROR "usage: -DROOT=<tree> [-DALLOWLIST=<file>] [-DDIRS=<list>]")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT ALLOWLIST)
  set(ALLOWLIST "${ROOT}/tools/config_access_check/allowlist.txt")
endif()
if(NOT DIRS)
  set(DIRS "engine;game")
endif()

function(read_lines path out)
  file(READ "${path}" content)
  string(REPLACE ";" "<SEMI>" content "${content}")
  string(REPLACE "[" "<LB>" content "${content}")
  string(REPLACE "]" "<RB>" content "${content}")
  string(REPLACE "\n" ";" content "${content}")
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

set(allow_paths "")
if(EXISTS "${ALLOWLIST}")
  file(STRINGS "${ALLOWLIST}" allow_lines)
  foreach(line IN LISTS allow_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(FIND "${line}" "|" bar)
    if(bar LESS 1)
      message(SEND_ERROR "${ALLOWLIST}: an entry needs `path|reason`: ${line}")
      continue()
    endif()
    string(SUBSTRING "${line}" 0 ${bar} p)
    math(EXPR after "${bar}+1")
    string(SUBSTRING "${line}" ${after} -1 reason)
    string(STRIP "${reason}" reason)
    if(reason STREQUAL "")
      message(SEND_ERROR "${ALLOWLIST}: the entry for ${p} has no reason")
    endif()
    list(APPEND allow_paths "${p}")
  endforeach()
endif()
set(allow_used "")

set(env_re "(^|[^A-Za-z0-9_.>])(std::)?(getenv|secure_getenv)[ \t]*\\(")
set(flag_re "\"--[a-z][a-z0-9-]*")

set(files "")
foreach(dir IN LISTS DIRS)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.cpp" "${ROOT}/${dir}/*.cc" "${ROOT}/${dir}/*.mm")
  list(APPEND files ${found})
endforeach()
list(REMOVE_DUPLICATES files)

set(errors 0)
set(scanned 0)
foreach(f IN LISTS files)
  if(f MATCHES "/generated/")
    continue()
  endif()
  math(EXPR scanned "${scanned}+1")
  set(entry -1)
  set(i 0)
  foreach(p IN LISTS allow_paths)
    if((p MATCHES "/$" AND f MATCHES "^${p}") OR f STREQUAL p)
      set(entry ${i})
    endif()
    math(EXPR i "${i}+1")
  endforeach()
  read_lines("${ROOT}/${f}" lines)
  set(n 0)
  set(in_block FALSE)
  foreach(l IN LISTS lines)
    math(EXPR n "${n}+1")
    set(code "${l}")
    if(in_block)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        continue()
      endif()
      math(EXPR after "${close}+2")
      string(SUBSTRING "${code}" ${after} -1 code)
      set(in_block FALSE)
    endif()
    string(REGEX REPLACE "/\\*[^*]*\\*+([^/*][^*]*\\*+)*/" " " code "${code}")
    # A line comment, whole-line or trailing: keep what precedes the first `//` that is not inside a string literal.
    string(REGEX REPLACE "^(([^\"/]|\"([^\"\\]|\\.)*\"|/[^/])*)//.*$" "\\1" code "${code}")
    string(FIND "${code}" "/*" open)
    if(NOT open LESS 0)
      string(FIND "${code}" "*/" close)
      if(close LESS 0)
        string(SUBSTRING "${code}" 0 ${open} code)
        set(in_block TRUE)
      endif()
    endif()
    set(hit FALSE)
    if(code MATCHES "${env_re}" OR code MATCHES "${flag_re}")
      set(hit TRUE)
    endif()
    if(NOT hit)
      continue()
    endif()
    if(NOT entry EQUAL -1)
      list(APPEND allow_used ${entry})
      continue()
    endif()
    string(REPLACE "<LB>" "[" shown "${l}")
    string(REPLACE "<RB>" "]" shown "${shown}")
    string(REPLACE "<SEMI>" ";" shown "${shown}")
    string(STRIP "${shown}" shown)
    message(SEND_ERROR "${f}:${n}: configuration read outside the settings system (getenv or a --flag); register a setting and read it through settings::Setting or settings::Settings, or add the file to tools/config_access_check/allowlist.txt with a reason: ${shown}")
    math(EXPR errors "${errors}+1")
  endforeach()
endforeach()

set(i 0)
foreach(p IN LISTS allow_paths)
  list(FIND allow_used ${i} found_at)
  if(found_at LESS 0)
    message(SEND_ERROR "${ALLOWLIST}: stale entry ${p}: nothing in it reads configuration outside the settings system any more; remove it")
    math(EXPR errors "${errors}+1")
  endif()
  math(EXPR i "${i}+1")
endforeach()

if(errors GREATER 0)
  message(FATAL_ERROR "config_access_check: ${errors} problem(s)")
endif()
message(STATUS "config_access_check: ${scanned} files clean")
